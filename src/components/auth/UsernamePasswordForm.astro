---
import HospitalAutocomplete from '../HospitalAutocomplete.astro';

// 아이디/비밀번호 회원가입·로그인 폼. 명세: .spec/src/components/auth/UsernamePasswordForm.md
// Stage 1-A (documents/privacy_redesign_plan.md 1단계) + Phase 2(2단계 개정 —
// 2계층+가입승인+제재, KSNM 방안위 교육팀 합의 2026-09-10 승계).
---

<div class="username-auth-section">
    <div class="mode-tabs">
        <button type="button" class="mode-tab active" id="modeLoginTab" data-mode="login">로그인</button>
        <button type="button" class="mode-tab" id="modeSignupTab" data-mode="signup">아이디 만들기</button>
    </div>

    <form id="usernameAuthForm" class="username-auth-form">
        <input
            type="text"
            id="usernameInput"
            placeholder="아이디 (영문 소문자·숫자·_·- 3~20자)"
            pattern="[a-z0-9_-]{3,20}"
            autocomplete="username"
            required
        />
        <input
            type="password"
            id="passwordInput"
            placeholder="비밀번호 (8자 이상)"
            minlength="8"
            autocomplete="current-password"
            required
        />
        <div id="signupOnlyFields" class="signup-only-fields" hidden>
            <HospitalAutocomplete />
            <select id="societySelect" class="society-select">
                <option value="">소속학회 선택 (선택사항)</option>
                <option value="nuclear_medicine">대한핵의학회</option>
                <option value="technology">대한핵의학기술학회</option>
                <option value="none">비소속</option>
            </select>
        </div>
        <button type="submit" class="username-auth-btn" id="usernameAuthSubmitBtn">로그인</button>
    </form>
    <p class="username-auth-msg" id="usernameAuthMsg" hidden></p>
</div>

<style>
    .username-auth-section {
        margin-bottom: 1rem;
    }
    .mode-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .mode-tab {
        flex: 1;
        padding: 0.5rem;
        border: 1px solid #d1d5db;
        background: white;
        border-radius: 6px;
        font-size: 0.85rem;
        color: #6b7280;
        cursor: pointer;
        transition: all 0.2s;
    }
    .mode-tab.active {
        border-color: var(--accent);
        color: var(--accent);
        font-weight: 600;
    }
    .username-auth-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .username-auth-form input {
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 1rem;
    }
    .signup-only-fields {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    /* author 의 display:flex 가 UA 의 [hidden]{display:none} 을 이겨버리므로 명시적으로
       복원. 없으면 로그인 탭에서도 소속기관·소속학회 입력란이 계속 보여서 페이지가
       늘어나고, 아래 로그인 버튼이 LoginGuide 배너(고정 위치, top:60%)에 가려진다
       (2026-09-16 CI e2e public-pages.spec.ts 실패로 발견 — 당시엔 EmailOtpForm.astro
       에도 같은 함정이 있었으나 그 컴포넌트는 Stage C, 2026-09-18로 삭제됨). */
    .signup-only-fields[hidden] {
        display: none;
    }
    /* 배경·글자색은 global.css 의 input/select 다크 규칙을 그대로 따른다 — 위 아이디·비밀번호
       입력란과 같은 외관. 예전의 background:white + color:inherit 는 흰 배경에 body 의
       밝은 글자색이 얹혀 읽을 수 없었다(2026-09-18 운영 실측). */
    .society-select {
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 1rem;
    }
    .username-auth-btn {
        background: #111827;
        color: white;
        padding: 0.75rem;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }
    .username-auth-btn:hover {
        background: #374151;
    }
    .username-auth-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
    .username-auth-msg {
        font-size: 0.8rem;
        color: #ef4444;
        margin-top: 0.4rem;
        margin-bottom: 0;
    }
</style>

<script>
    import { supabase } from '../../lib/supabase-browser';
    import { track } from '../../lib/usage/track';

    const loginTab = document.getElementById('modeLoginTab') as HTMLButtonElement;
    const signupTab = document.getElementById('modeSignupTab') as HTMLButtonElement;
    const form = document.getElementById('usernameAuthForm') as HTMLFormElement;
    const usernameInput = document.getElementById('usernameInput') as HTMLInputElement;
    const passwordInput = document.getElementById('passwordInput') as HTMLInputElement;
    const submitBtn = document.getElementById('usernameAuthSubmitBtn') as HTMLButtonElement;
    const msgEl = document.getElementById('usernameAuthMsg') as HTMLParagraphElement;
    const signupOnlyFields = document.getElementById('signupOnlyFields') as HTMLDivElement;
    const hospitalIdInput = document.getElementById('hospitalId') as HTMLInputElement;
    const hospitalRequestInput = document.getElementById('hospitalRequest') as HTMLInputElement;
    const societySelect = document.getElementById('societySelect') as HTMLSelectElement;

    let mode: 'login' | 'signup' = 'login';

    function setMode(next: 'login' | 'signup') {
        mode = next;
        loginTab.classList.toggle('active', next === 'login');
        signupTab.classList.toggle('active', next === 'signup');
        submitBtn.textContent = next === 'login' ? '로그인' : '가입하고 시작하기';
        passwordInput.autocomplete = next === 'login' ? 'current-password' : 'new-password';
        // Phase 2 — 소속기관·소속학회는 신규 가입에서만 물어본다(로그인 탭에는 불필요).
        signupOnlyFields.hidden = next !== 'signup';
        msgEl.hidden = true;
    }

    loginTab?.addEventListener('click', () => setMode('login'));
    signupTab?.addEventListener('click', () => setMode('signup'));

    async function goToLastRoute() {
        const { getLastRoute } = await import('../../lib/last-route');
        const last = getLastRoute();
        window.location.href = last && last.path !== '/' ? last.path : '/mypage';
    }

    function showError(message: string) {
        msgEl.textContent = message;
        msgEl.hidden = false;
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = usernameInput.value.trim().toLowerCase();
        const password = passwordInput.value;
        if (!username || !password) return;

        submitBtn.disabled = true;
        submitBtn.textContent = mode === 'login' ? '로그인 중...' : '가입 중...';
        msgEl.hidden = true;

        try {
            const { actions } = await import('astro:actions');
            const result =
                mode === 'signup'
                    ? await (actions as any).signUpWithUsername({
                          username,
                          password,
                          hospitalId: hospitalIdInput?.value || '',
                          ...(hospitalRequestInput?.value ? { hospitalRequest: hospitalRequestInput.value } : {}),
                          ...(societySelect?.value ? { society: societySelect.value } : {}),
                      })
                    : await (actions as any).signInWithUsername({ username });

            if (result.error) throw new Error(result.error.message);

            const email = result.data.email;
            const { error: signInError } = await supabase.auth.signInWithPassword({ email, password });
            if (signInError) throw new Error('아이디 또는 비밀번호가 올바르지 않습니다.');

            // 로그인 성공은 여기서만 알 수 있다 — 서버 액션은 이메일을 찾아 줄 뿐이라
            // 거기서 세면 성공이 아니라 시도를 세게 된다(U-3). 카카오는 서버 콜백이 기록한다.
            if (mode === 'login') track('login', { props: { method: 'password' } });

            // 새 계정에는 "돌아갈 마지막 경로"가 없다 — 같은 브라우저의 이전 계정이 남긴 경로다.
            if (mode === 'signup') {
                window.location.href = '/mypage';
                return;
            }
            await goToLastRoute();
        } catch (err) {
            showError(err instanceof Error ? err.message : String(err));
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = mode === 'login' ? '로그인' : '가입하고 시작하기';
        }
    });
</script>
