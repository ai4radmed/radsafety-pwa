---
// 소속기관 자동완성 콤보박스. 명세: .spec/src/components/HospitalAutocomplete.md
// Phase 2 (documents/privacy_redesign_plan.md 2단계 개정 — 2계층+가입승인+제재).
// 180개(예정) 항목을 네이티브 <select>로 두면 모바일에서 스크롤 지옥이라
// 타이핑하면 필터링되는 콤보박스로 대체(Dr. Ben 2026-09-16 요청).
---

<div class="hospital-autocomplete">
    <input
        type="text"
        id="hospitalQuery"
        class="hospital-query-input"
        placeholder="소속기관 검색 (선택사항)"
        autocomplete="off"
    />
    <input type="hidden" id="hospitalId" name="hospitalId" />
    <input type="hidden" id="hospitalRequest" name="hospitalRequest" />
    <ul id="hospitalOptions" class="hospital-options" hidden></ul>
    <p id="hospitalNoMatchHint" class="hospital-hint" hidden>
        목록에 없는 기관이에요. 이대로 진행하면 소속은 <strong>기타</strong>로 등록되고, 입력하신 기관명이 관리자에게
        등록 요청으로 전달됩니다(등록되면 알림으로 알려드려요).
    </p>
</div>

<style>
    .hospital-autocomplete {
        position: relative;
    }
    .hospital-query-input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 1rem;
    }
    .hospital-options {
        position: absolute;
        z-index: 20;
        top: calc(100% + 2px);
        left: 0;
        right: 0;
        max-height: 12rem;
        overflow-y: auto;
        margin: 0;
        padding: 0.25rem 0;
        list-style: none;
        background: white;
        color: #111827; /* body 글자색(다크 테마 밝은색)이 흰 배경에 상속되지 않도록 */
        border: 1px solid #d1d5db;
        border-radius: 6px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .hospital-options li {
        padding: 0.6rem 0.75rem;
        font-size: 0.9rem;
        cursor: pointer;
    }
    .hospital-options li:hover,
    .hospital-options li:active {
        background: #f3f4f6;
    }
    .hospital-hint {
        margin: 0.35rem 0 0;
        font-size: 0.8rem;
        line-height: 1.4;
        color: #9ca3af;
        text-align: left;
    }
</style>

<script>
    import { HOSPITALS, type Hospital } from '../data/hospitals';
    import { supabase } from '../lib/supabase-browser';

    const queryInput = document.getElementById('hospitalQuery') as HTMLInputElement;
    const hiddenInput = document.getElementById('hospitalId') as HTMLInputElement;
    const requestInput = document.getElementById('hospitalRequest') as HTMLInputElement;
    const optionsList = document.getElementById('hospitalOptions') as HTMLUListElement;
    const noMatchHint = document.getElementById('hospitalNoMatchHint') as HTMLParagraphElement;

    // 'other'(기타)는 검색 후보에서 뺀다 — 목록에 없는 기관은 아래 요청 경로로 흡수된다.
    let active: Hospital[] = HOSPITALS.filter((h) => !h.retired && h.id !== 'other');

    // 관리자가 화면에서 등록한 기관(hospitals_custom, anon 읽기 허용)을 정적 목록에 합친다.
    // 실패해도 정적 목록만으로 동작 — 자동완성이 가입을 막아선 안 된다.
    (async () => {
        try {
            const { data } = await supabase.from('hospitals_custom').select('id, name').eq('retired', false);
            if (data?.length) active = [...active, ...(data as Hospital[])];
        } catch {
            // ignore
        }
    })();

    function renderOptions(query: string) {
        optionsList.innerHTML = '';
        if (!query) {
            optionsList.hidden = true;
            noMatchHint.hidden = true;
            return;
        }
        const matches = active.filter((h) => h.name.includes(query)).slice(0, 8);
        noMatchHint.hidden = matches.length !== 0;
        if (matches.length === 0) {
            optionsList.hidden = true;
            return;
        }
        matches.forEach((h) => {
            const li = document.createElement('li');
            li.textContent = h.name;
            // mousedown(클릭)이 input의 blur 보다 먼저 처리되도록 — blur 핸들러가
            // 목록을 먼저 숨겨버리면 클릭이 무효화된다.
            li.addEventListener('mousedown', (e) => {
                e.preventDefault();
                queryInput.value = h.name;
                hiddenInput.value = h.id;
                requestInput.value = '';
                optionsList.hidden = true;
                noMatchHint.hidden = true;
            });
            optionsList.appendChild(li);
        });
        optionsList.hidden = false;
    }

    queryInput?.addEventListener('input', () => {
        // 직접 타이핑하면 이전에 선택했던 값은 무효 — 목록에서 다시 골라야 확정된다.
        // 확정하지 않은 타이핑 텍스트는 그대로 "등록 요청"이 된다(2026-09-19).
        hiddenInput.value = '';
        const query = queryInput.value.trim();
        requestInput.value = query;
        renderOptions(query);
    });

    queryInput?.addEventListener('blur', () => {
        setTimeout(() => {
            optionsList.hidden = true;
        }, 150);
    });
</script>
