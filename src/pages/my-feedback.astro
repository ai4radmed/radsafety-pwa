---
export const prerender = false;

import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
---

<DashboardLayout title="내 의견함">
    <style>
        .my-feedback-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .page-header {
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .action-buttons {
            display: flex;
            gap: 0.75rem;
        }

        /* Feedback Cards */
        .feedback-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .feedback-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .feedback-card:hover {
            border-color: var(--accent);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 1rem;
        }
        .card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }
        .card-meta {
            display: flex;
            gap: 1rem;
            align-items: center;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .card-message {
            color: var(--text-main);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid var(--border-color);
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.85rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .badge-pending {
            background: #fef3c7;
            color: #92400e;
        }
        .badge-processing {
            background: #dbeafe;
            color: #1e40af;
        }
        .badge-resolved {
            background: #d1fae5;
            color: #065f46;
        }

        .attachment-count {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: var(--text-muted);
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }
        .empty-state-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .btn {
            padding: 0.65rem 1.25rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-primary {
            background: var(--accent);
            color: white;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }

        /* Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-backdrop.active {
            display: flex;
        }
        .modal-content {
            background: var(--bg-card);
            border-radius: 12px;
            max-width: 700px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }
        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0.25rem;
        }
        .modal-body {
            padding: 1.5rem;
        }

        .info-row {
            margin-bottom: 1.5rem;
        }
        .info-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .info-value {
            color: var(--text-main);
            font-size: 0.95rem;
        }
        .info-message {
            background: var(--bg-body);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .attachments-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .attachment-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem;
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }
        .attachment-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .attachment-name {
            font-size: 0.9rem;
            color: var(--text-main);
        }
        .attachment-size {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
        }
    </style>

    <div class="my-feedback-container">
        <div class="page-header">
            <div>
                <h1 class="page-title">
                    <Icon name="mail" size="32" /> 내 의견함
                </h1>
                <p class="page-subtitle">제출한 의견의 처리 상태를 확인할 수 있습니다.</p>
            </div>
            <div class="action-buttons">
                <a href="/feedback" class="btn btn-primary">
                    <Icon name="mail" size="18" /> 의견 보내기
                </a>
            </div>
        </div>

        <div id="feedbackList" class="feedback-list">
            <div class="empty-state">로딩 중...</div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div id="feedbackModal" class="modal-backdrop">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">의견 상세</h2>
                <button class="modal-close" id="closeModal">×</button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>

    <script>
        import { supabase } from '../lib/supabase-browser';
        import { userProfile } from '../store/user';

        interface Feedback {
            id: string;
            user_name: string;
            user_email: string;
            title: string;
            message: string;
            attachments: Array<{
                filename: string;
                storage_path: string;
                size: number;
            }>;
            status: 'pending' | 'processing' | 'resolved';
            admin_note: string | null;
            created_at: string;
            resolved_at: string | null;
        }

        let user = userProfile.get();
        const feedbackList = document.getElementById('feedbackList');
        const modal = document.getElementById('feedbackModal');
        const modalBody = document.getElementById('modalBody');
        const closeModalBtn = document.getElementById('closeModal');

        let myFeedback: Feedback[] = [];

        // Load user's feedback
        async function loadMyFeedback() {
            // Re-fetch user in case it wasn't loaded yet
            user = userProfile.get();

            console.log('[my-feedback] Loading feedback for user:', user?.id);

            if (!user || !user.id) {
                console.log('[my-feedback] No user logged in');
                if (feedbackList) {
                    feedbackList.innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">🔒</div>
                            <p>로그인이 필요합니다.</p>
                        </div>
                    `;
                }
                return;
            }

            try {
                console.log('[my-feedback] Querying feedback table...');
                const { data, error } = await supabase
                    .from('feedback')
                    .select('*')
                    .eq('user_id', user.id)
                    .order('created_at', { ascending: false });

                console.log('[my-feedback] Query result:', { data, error });

                if (error) {
                    console.error('[my-feedback] Query error:', error);
                    throw error;
                }

                myFeedback = data || [];
                console.log('[my-feedback] Loaded', myFeedback.length, 'feedback items');
                renderFeedbackList();
            } catch (error) {
                console.error('[my-feedback] Failed to load feedback:', error);
                if (feedbackList) {
                    feedbackList.innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">⚠️</div>
                            <p>데이터를 불러오는데 실패했습니다.</p>
                            <p style="margin-top: 0.5rem; font-size: 0.85rem;">
                                ${error instanceof Error ? error.message : '알 수 없는 오류'}
                            </p>
                        </div>
                    `;
                }
            }
        }

        // Render feedback list
        function renderFeedbackList() {
            if (!feedbackList) return;

            if (myFeedback.length === 0) {
                feedbackList.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">📭</div>
                        <p>아직 제출한 의견이 없습니다.</p>
                        <p style="margin-top: 0.5rem;">
                            <a href="/feedback" class="btn btn-primary" style="margin-top: 1rem;">
                                의견 보내기
                            </a>
                        </p>
                    </div>
                `;
                return;
            }

            feedbackList.innerHTML = myFeedback
                .map((feedback) => {
                    const date = new Date(feedback.created_at).toLocaleDateString('ko-KR', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                    });
                    const statusClass = `badge-${feedback.status}`;
                    const statusText = {
                        pending: '대기중',
                        processing: '처리중',
                        resolved: '완료',
                    }[feedback.status];

                    return `
                    <div class="feedback-card" data-id="${feedback.id}">
                        <div class="card-header">
                            <div style="flex: 1;">
                                <div class="card-title">${feedback.title}</div>
                                <div class="card-meta">
                                    <span>${date}</span>
                                    <span class="status-badge ${statusClass}">${statusText}</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-message">${feedback.message}</div>
                        <div class="card-footer">
                            <div class="attachment-count">
                                ${feedback.attachments?.length > 0 ? `📎 ${feedback.attachments.length}개 첨부` : ''}
                            </div>
                            <div style="color: var(--text-muted); font-size: 0.85rem;">
                                자세히 보기 →
                            </div>
                        </div>
                    </div>
                `;
                })
                .join('');

            // Add click handlers
            feedbackList.querySelectorAll('.feedback-card').forEach((card) => {
                card.addEventListener('click', () => {
                    const id = (card as HTMLElement).dataset.id;
                    const feedback = myFeedback.find((f) => f.id === id);
                    if (feedback) {
                        openModal(feedback);
                    }
                });
            });
        }

        // Open modal
        function openModal(feedback: Feedback) {
            if (!modal || !modalBody) return;

            const date = new Date(feedback.created_at).toLocaleString('ko-KR');
            const resolvedDate = feedback.resolved_at ? new Date(feedback.resolved_at).toLocaleString('ko-KR') : '-';

            const statusText = {
                pending: '대기중',
                processing: '처리중',
                resolved: '완료',
            }[feedback.status];

            modalBody.innerHTML = `
                <div class="info-row">
                    <div class="info-label">제목</div>
                    <div class="info-value" style="font-weight: 700; font-size: 1.1rem;">${feedback.title}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">제출일</div>
                    <div class="info-value">${date}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">상태</div>
                    <div class="info-value">
                        <span class="status-badge badge-${feedback.status}">${statusText}</span>
                    </div>
                </div>
                ${
                    feedback.status === 'resolved'
                        ? `
                <div class="info-row">
                    <div class="info-label">처리 완료일</div>
                    <div class="info-value">${resolvedDate}</div>
                </div>
                `
                        : ''
                }
                <div class="info-row">
                    <div class="info-label">내용</div>
                    <div class="info-message">${feedback.message}</div>
                </div>
                ${
                    feedback.attachments && feedback.attachments.length > 0
                        ? `
                <div class="info-row">
                    <div class="info-label">첨부파일 (${feedback.attachments.length}개)</div>
                    <div class="attachments-list">
                        ${feedback.attachments
                            .map((att) => {
                                const sizeKB = (att.size / 1024).toFixed(1);
                                return `
                                <div class="attachment-item">
                                    <div class="attachment-info">
                                        <span class="attachment-name">📎 ${att.filename}</span>
                                        <span class="attachment-size">(${sizeKB} KB)</span>
                                    </div>
                                    <button class="btn btn-primary btn-sm" onclick="downloadAttachment('${att.storage_path}', '${att.filename}')">
                                        다운로드
                                    </button>
                                </div>
                            `;
                            })
                            .join('')}
                    </div>
                </div>
                `
                        : ''
                }
                ${
                    feedback.admin_note
                        ? `
                <div class="info-row">
                    <div class="info-label">관리자 메모</div>
                    <div class="info-message" style="background: #fef3c7; border-color: #fde047;">${feedback.admin_note}</div>
                </div>
                `
                        : ''
                }
            `;

            modal.classList.add('active');
        }

        // Close modal
        function closeModal() {
            modal?.classList.remove('active');
        }

        // Download attachment
        (window as any).downloadAttachment = async function (storagePath: string, filename: string) {
            try {
                const { data, error } = await supabase.storage.from('feedback-attachments').download(storagePath);

                if (error) throw error;

                const url = URL.createObjectURL(data);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                a.click();
                URL.revokeObjectURL(url);
            } catch (error) {
                console.error('Failed to download file:', error);
                alert('파일 다운로드에 실패했습니다.');
            }
        };

        // Close modal on backdrop click
        modal?.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        closeModalBtn?.addEventListener('click', closeModal);

        // Initial load on page load event
        document.addEventListener('astro:page-load', () => {
            loadMyFeedback();
        });
    </script>
</DashboardLayout>
