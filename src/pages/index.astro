---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
---

<DashboardLayout>
    <div class="hero">
        <p class="intro">
            RadSafety는 <strong>대한핵의학회 방사선안전위원회</strong>와 <strong
                >대한핵의학기술학회 방사선안전관리위원회</strong
            >가 회원들과 유용한 정보를 공유하기 위해 <span style="color: #ef4444; font-weight: 600;">개발 중인</span> 앱입니다.
        </p>

        <div class="card-grid">
            <a href="/inspection-prep" class="card primary">
                <div class="card-header">
                    <Icon name="check-square" size="20" class="card-icon" />
                    <h3>정기검사 수검준비</h3>
                </div>
                <p class="card-desc">KINS 정기검사 수검가이드 및 실무 체크리스트</p>
            </a>

            <a href="/findings-recommendations" class="card secondary">
                <div class="card-header">
                    <Icon name="alert-circle" size="20" class="card-icon" />
                    <h3>지적권고사례</h3>
                </div>
                <p class="card-desc">정기검사 지적 및 권고 사례 모음</p>
            </a>

            <a href="/resources" class="card secondary">
                <div class="card-header">
                    <Icon name="folder" size="20" class="card-icon" />
                    <h3>자료실</h3>
                </div>
                <p class="card-desc">작성지침, 예시 및 각종 발표자료</p>
            </a>

            <a href="/feedback" class="card secondary">
                <div class="card-header">
                    <Icon name="mail" size="20" class="card-icon" />
                    <h3>의견보내기</h3>
                </div>
                <p class="card-desc">앱 오류 및 개선사항을 관리자에게 보내기</p>
            </a>
        </div>

        <!-- Action Area -->
        <div style="text-align: center; margin-top: 0.75rem; margin-bottom: 0.5rem;">
            <a
                href="/login"
                style="
				display: inline-block;
				background-color: var(--accent);
				color: white;
				padding: 0.6rem 1.5rem;
				border-radius: 99px;
				font-weight: bold;
				text-decoration: none;
				font-size: 0.95rem;
				box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
				transition: transform 0.2s, box-shadow 0.2s;
			"
                class="primary-cta-btn"
            >
                카카오 또는 이메일 인증으로 앱 시작하기
            </a>
        </div>
    </div>

    <style>
        .hero {
            text-align: left;
            padding: 0; /* Minimized */
            max-width: 800px;
            margin: 0 auto;
        }
        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: #111827;
        }
        .intro {
            font-size: 0.85rem;
            color: #6b7280;
            margin: 0 0 1rem 0; /* Minimized */
            line-height: 1.4;
        }
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 0.4rem; /* Ultra Tight Gap */
            text-align: left;
        }
        .card {
            padding: 0.5rem 0.75rem; /* Smoothed Padding */
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px var(--shadow-color);
            text-decoration: none;
            color: inherit;
            transition:
                transform 0.2s,
                box-shadow 0.2s;
            border: 1px solid var(--border-color);
        }
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px var(--shadow-color);
            background-color: #27272a !important; /* Slightly lighter on hover */
        }
        .card.primary {
            border-left: 5px solid var(--accent);
        }

        .primary-cta-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 16px rgba(59, 130, 246, 0.5);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-bottom: 0.2rem; /* Tight header margin */
        }

        /* Pass class via global styles or explicit prop if component supports it. 
		   Since Icon.astro applies {className}, usage <Icon class="card-icon" /> works.
		*/
        :global(.card-icon) {
            color: var(--text-muted);
        }

        .card h3 {
            margin: 0;
            color: var(--text-main);
            font-size: 0.9rem; /* Reduced from 1rem to match inspection-prep visual size */
            font-weight: 600;
        }
        .card p.card-desc {
            margin: 0;
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.3;
        }

        @media (max-width: 480px) {
            .card p.card-desc {
                font-size: 0.75rem; /* Slightly smaller on small screens */
            }
            .card-header h3 {
                font-size: 0.85rem; /* Reduced from 0.95rem */
            }
        }

        @media (max-width: 768px) {
            .desktop-only {
                display: none;
            }
        }
        @media (min-width: 769px) {
            .mobile-only {
                display: none;
            }
        }
    </style>

    <script>
        import { restoreLastRouteIfNeeded } from '../lib/last-route';
        import { diagLog } from '../lib/session-diag'; // [SESSION-DIAG]
        // astro:page-load는 직접 접속과 View Transitions 재방문 모두에서 발생하므로
        // readyState 체크 없이 단일 이벤트로 처리 (codebase_guide.md 3-4 참조)
        document.addEventListener('astro:page-load', () => {
            diagLog('L5:restoreRoute', {
                pathname: window.location.pathname,
                lastRoute: localStorage.getItem('last_route'),
                sessionChecked: !!sessionStorage.getItem('last_route_checked'),
            }); // [SESSION-DIAG]
            if (restoreLastRouteIfNeeded()) return; // 리다이렉트 발생
        });
    </script>
</DashboardLayout>
