---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
const vapidPublicKey = import.meta.env.PUBLIC_VAPID_KEY;
---

<DashboardLayout title="설정">
    <div class="settings-container">
        <h1><Icon name="settings" size="32" class="title-icon" /> 설정</h1>
        <p class="subtitle">앱의 화면 및 기능을 사용자 환경에 맞게 조정합니다.</p>

        <div class="setting-card">
            <div class="setting-header">
                <h2>화면 설정</h2>
                <p>글자 크기를 조절하여 더 편안하게 볼 수 있습니다.</p>
            </div>

            <div class="control-group">
                <div class="label">글자 크기 (Font Size)</div>
                <div class="font-preview" id="fontPreview">가가가 (미리보기)</div>
                <div class="font-control-options">
                    <button class="font-btn small" data-size="small" aria-label="글자 작게">
                        <span style="font-size: 0.8rem;">가</span>
                        <span class="btn-label">작게</span>
                    </button>
                    <button class="font-btn medium active" data-size="medium" aria-label="글자 보통">
                        <span style="font-size: 1rem;">가</span>
                        <span class="btn-label">보통</span>
                    </button>
                    <button class="font-btn large" data-size="large" aria-label="글자 크게">
                        <span style="font-size: 1.2rem;">가</span>
                        <span class="btn-label">크게</span>
                    </button>
                    <button class="font-btn xlarge" data-size="xlarge" aria-label="글자 아주 크게">
                        <span style="font-size: 1.5rem;">가</span>
                        <span class="btn-label">아주 크게</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="setting-card" style="margin-top: 1.5rem;">
            <div class="setting-header">
                <h2>알림 설정</h2>
                <p>새로운 알림을 즉시 받아볼 수 있습니다.</p>
            </div>
            <div class="control-group">
                <div class="push-row">
                    <div class="push-info">
                        <div class="push-label">푸시 알림 받기</div>
                        <div class="push-status" id="pushStatusText">확인 중...</div>
                    </div>
                    <button id="pushBtn" class="push-btn" style="display:none;">알림 켜기</button>
                    <button id="pushOffBtn" class="push-btn push-btn--off" style="display:none;">알림 끄기</button>
                </div>
                <div id="pushDeniedMsg" class="push-msg push-msg--error" style="display:none;">
                    브라우저에서 알림이 차단되어 있습니다. 브라우저 설정에서 알림 권한을 허용해 주세요.
                </div>
                <div id="pushUnsupportedMsg" class="push-msg push-msg--error" style="display:none;">
                    이 브라우저는 푸시 알림을 지원하지 않습니다.
                </div>
            </div>
        </div>
    </div>

    <style>
        .settings-container {
            max-width: 800px;
            margin: 0 auto;
        }
        h1 {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }
        .subtitle {
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        .setting-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 1px 3px var(--shadow-color);
        }

        .setting-header h2 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }
        .setting-header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
        }

        .control-group {
            border-top: 1px solid var(--border-color);
            padding-top: 1.5rem;
        }

        .label {
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--accent);
        }

        .font-preview {
            background: var(--bg-body);
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 1rem;
            border: 1px solid var(--border-color);
            transition: font-size 0.2s;
        }

        .font-control-options {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.5rem;
        }

        .font-btn {
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 1rem 0.5rem;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s;
        }

        .font-btn:hover {
            border-color: var(--accent);
            color: var(--text-main);
        }

        .font-btn.active {
            background: rgba(37, 99, 235, 0.1);
            color: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.3);
        }

        .btn-label {
            font-size: 0.85rem !important; /* Fixed size label */
            opacity: 0.8;
        }

        /* Push 알림 */
        .push-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }
        .push-label {
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 0.2rem;
        }
        .push-status {
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .push-btn {
            padding: 0.4rem 1rem;
            font-size: 0.85rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            white-space: nowrap;
            flex-shrink: 0;
            background: var(--accent, #2563eb);
            color: #fff;
            transition: opacity 0.2s;
        }
        .push-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .push-btn--off {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
        }
        .push-msg {
            margin-top: 0.75rem;
            padding: 0.6rem 0.8rem;
            border-radius: 6px;
            font-size: 0.85rem;
        }
        .push-msg--error {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }

        @media (max-width: 600px) {
            .font-control-options {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>

    <script define:vars={{ vapidPublicKey }}>
        function urlBase64ToUint8Array(base64String) {
            const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
            const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
            const rawData = atob(base64);
            return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
        }

        const SUBSCRIBED_KEY = 'push_subscribed';

        document.addEventListener('astro:page-load', async () => {
            // ── 글자 크기 ──────────────────────────────────────────
            const fontBtns = document.querySelectorAll('.font-btn');
            const currentSize = localStorage.getItem('fontSize') || 'medium';

            fontBtns.forEach((btn) => {
                if (btn.dataset.size === currentSize) btn.classList.add('active');
                else btn.classList.remove('active');

                btn.addEventListener('click', () => {
                    const newSize = btn.dataset.size;
                    document.documentElement.setAttribute('data-font-size', newSize);
                    localStorage.setItem('fontSize', newSize);
                    fontBtns.forEach((b) => b.classList.remove('active'));
                    btn.classList.add('active');
                });
            });

            // ── 푸시 알림 ──────────────────────────────────────────
            const statusText = document.getElementById('pushStatusText');
            const pushBtn = document.getElementById('pushBtn');
            const pushOffBtn = document.getElementById('pushOffBtn');
            const deniedMsg = document.getElementById('pushDeniedMsg');
            const unsupportedMsg = document.getElementById('pushUnsupportedMsg');

            if (!statusText || !pushBtn || !pushOffBtn) return;

            // 브라우저 지원 확인
            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
                statusText.textContent = '지원하지 않는 브라우저';
                unsupportedMsg.style.display = 'block';
                return;
            }

            // UI 상태 설정 헬퍼
            function setSubscribed(on) {
                pushBtn.style.display = on ? 'none' : 'inline-block';
                pushOffBtn.style.display = on ? 'inline-block' : 'none';
                statusText.textContent = on ? '알림 켜짐' : '알림 꺼짐';
            }

            function setLoading(msg) {
                pushBtn.style.display = 'none';
                pushOffBtn.style.display = 'none';
                statusText.textContent = msg;
            }

            // localhost(개발 서버)에서는 SW가 작동하지 않으므로 버튼 비활성화
            const isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
            if (isLocalhost) {
                statusText.textContent = '앱 설치 후 사용 가능';
                return;
            }

            // 초기 상태 확인 — localStorage만 참조 (SW 대기 없음, UX 지연 없음)
            const cachedOn = localStorage.getItem(SUBSCRIBED_KEY) === 'true' && Notification.permission === 'granted';

            if (Notification.permission === 'denied') {
                statusText.textContent = '알림 권한이 차단됨';
                deniedMsg.style.display = 'block';
            } else {
                setSubscribed(cachedOn);
            }

            // ── 알림 켜기 버튼 ──────────────────────────────────
            pushBtn.addEventListener('click', async () => {
                setLoading('처리 중...');
                pushBtn.disabled = true;
                try {
                    // 권한 요청
                    if (Notification.permission !== 'granted') {
                        const perm = await Notification.requestPermission();
                        if (perm === 'denied') {
                            statusText.textContent = '알림 권한이 차단됨';
                            deniedMsg.style.display = 'block';
                            throw new Error('perm_denied');
                        }
                        if (perm !== 'granted') {
                            setSubscribed(false);
                            throw new Error('perm_dismissed');
                        }
                    }

                    // SW 준비 대기 (최대 15초)
                    const registration = await Promise.race([
                        navigator.serviceWorker.ready,
                        new Promise((_, reject) => setTimeout(() => reject(new Error('SW timeout')), 15000)),
                    ]);

                    let subscription = await registration.pushManager.getSubscription();
                    if (!subscription) {
                        subscription = await registration.pushManager.subscribe({
                            userVisibleOnly: true,
                            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
                        });
                    }

                    const res = await fetch('/api/push/subscribe', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            endpoint: subscription.endpoint,
                            p256dh: btoa(String.fromCharCode(...new Uint8Array(subscription.getKey('p256dh')))),
                            auth: btoa(String.fromCharCode(...new Uint8Array(subscription.getKey('auth')))),
                            userAgent: navigator.userAgent,
                        }),
                    });

                    if (res.ok) {
                        localStorage.setItem(SUBSCRIBED_KEY, 'true');
                        setSubscribed(true);
                    } else {
                        statusText.textContent = '구독 저장 실패. 다시 시도해 주세요.';
                        pushBtn.style.display = 'inline-block';
                    }
                } catch (err) {
                    if (!['perm_denied', 'perm_dismissed'].includes(err.message)) {
                        console.error('구독 오류:', err);
                        statusText.textContent = '오류가 발생했습니다. 다시 시도해 주세요.';
                        pushBtn.style.display = 'inline-block';
                    }
                } finally {
                    pushBtn.disabled = false;
                }
            });

            // ── 알림 끄기 버튼 ──────────────────────────────────
            pushOffBtn.addEventListener('click', async () => {
                setLoading('처리 중...');
                pushOffBtn.disabled = true;
                try {
                    const reg = await navigator.serviceWorker.getRegistration('/');
                    if (reg) {
                        const subscription = await reg.pushManager.getSubscription();
                        if (subscription) {
                            await fetch('/api/push/unsubscribe', {
                                method: 'DELETE',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ endpoint: subscription.endpoint }),
                            });
                            await subscription.unsubscribe();
                        }
                    }
                    localStorage.removeItem(SUBSCRIBED_KEY);
                    setSubscribed(false);
                } catch (err) {
                    console.error('구독 해제 오류:', err);
                    statusText.textContent = '오류가 발생했습니다. 다시 시도해 주세요.';
                    pushOffBtn.style.display = 'inline-block';
                } finally {
                    pushOffBtn.disabled = false;
                }
            });
        });
    </script>
</DashboardLayout>
