---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
---

<DashboardLayout title="설정">
    <div class="settings-container">
        <h1><Icon name="settings" size="32" class="title-icon" /> 설정</h1>
        <p class="subtitle">앱의 화면 및 기능을 사용자 환경에 맞게 조정합니다.</p>

        <div class="setting-card">
            <div class="setting-header">
                <h2>화면 설정</h2>
                <p>글자 크기를 조절하여 더 편안하게 볼 수 있습니다.</p>
            </div>

            <div class="control-group">
                <div class="label">글자 크기 (Font Size)</div>
                <div class="font-preview" id="fontPreview">가가가 (미리보기)</div>
                <div class="font-control-options">
                    <button class="font-btn small" data-size="small" aria-label="글자 작게">
                        <span style="font-size: 0.8rem;">가</span>
                        <span class="btn-label">작게</span>
                    </button>
                    <button class="font-btn medium active" data-size="medium" aria-label="글자 보통">
                        <span style="font-size: 1rem;">가</span>
                        <span class="btn-label">보통</span>
                    </button>
                    <button class="font-btn large" data-size="large" aria-label="글자 크게">
                        <span style="font-size: 1.2rem;">가</span>
                        <span class="btn-label">크게</span>
                    </button>
                    <button class="font-btn xlarge" data-size="xlarge" aria-label="글자 아주 크게">
                        <span style="font-size: 1.5rem;">가</span>
                        <span class="btn-label">아주 크게</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="setting-card" style="margin-top: 1.5rem;">
            <div class="setting-header">
                <h2>알림 설정</h2>
                <p>로그인 시 자동으로 푸시 알림이 활성화됩니다.</p>
            </div>
            <div class="control-group">
                <div class="push-row">
                    <div class="push-info">
                        <div class="push-label">푸시 알림</div>
                        <div class="push-status" id="pushStatusText">확인 중...</div>
                    </div>
                </div>
                <div id="pushDeniedMsg" class="push-msg push-msg--error" style="display:none;">
                    브라우저에서 알림이 차단되어 있습니다. 브라우저 설정에서 알림 권한을 허용한 후 페이지를 새로 고침해
                    주세요.
                </div>
                <div id="pushUnsupportedMsg" class="push-msg push-msg--error" style="display:none;">
                    이 브라우저는 푸시 알림을 지원하지 않습니다.
                </div>
            </div>
        </div>
    </div>

    <style>
        .settings-container {
            max-width: 800px;
            margin: 0 auto;
        }
        h1 {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }
        .subtitle {
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        .setting-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 1px 3px var(--shadow-color);
        }

        .setting-header h2 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }
        .setting-header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
        }

        .control-group {
            border-top: 1px solid var(--border-color);
            padding-top: 1.5rem;
        }

        .label {
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--accent);
        }

        .font-preview {
            background: var(--bg-body);
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 1rem;
            border: 1px solid var(--border-color);
            transition: font-size 0.2s;
        }

        .font-control-options {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.5rem;
        }

        .font-btn {
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 1rem 0.5rem;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s;
        }

        .font-btn:hover {
            border-color: var(--accent);
            color: var(--text-main);
        }

        .font-btn.active {
            background: rgba(37, 99, 235, 0.1);
            color: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.3);
        }

        .btn-label {
            font-size: 0.85rem !important; /* Fixed size label */
            opacity: 0.8;
        }

        /* Push 알림 */
        .push-row {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .push-label {
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 0.2rem;
        }
        .push-status {
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .push-status--on {
            color: #16a34a;
            font-weight: 600;
        }
        .push-msg {
            margin-top: 0.75rem;
            padding: 0.6rem 0.8rem;
            border-radius: 6px;
            font-size: 0.85rem;
        }
        .push-msg--error {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }

        @media (max-width: 600px) {
            .font-control-options {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>

    <script>
        document.addEventListener('astro:page-load', () => {
            // ── 글자 크기 ──────────────────────────────────────────
            const fontBtns = document.querySelectorAll('.font-btn');
            const currentSize = localStorage.getItem('fontSize') || 'medium';

            fontBtns.forEach((btn: any) => {
                if (btn.dataset.size === currentSize) btn.classList.add('active');
                else btn.classList.remove('active');

                btn.addEventListener('click', () => {
                    const newSize = btn.dataset.size;
                    document.documentElement.setAttribute('data-font-size', newSize);
                    localStorage.setItem('fontSize', newSize);
                    fontBtns.forEach((b) => b.classList.remove('active'));
                    btn.classList.add('active');
                });
            });

            // ── 푸시 알림 상태 표시 (읽기 전용) ──────────────────
            const statusText = document.getElementById('pushStatusText');
            const deniedMsg = document.getElementById('pushDeniedMsg');
            const unsupportedMsg = document.getElementById('pushUnsupportedMsg');

            if (!statusText) return;

            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
                statusText.textContent = '지원하지 않는 브라우저';
                if (unsupportedMsg) unsupportedMsg.style.display = 'block';
                return;
            }

            const perm = Notification.permission;
            if (perm === 'denied') {
                statusText.textContent = '차단됨 — 브라우저 설정에서 허용 필요';
                if (deniedMsg) deniedMsg.style.display = 'block';
            } else if (perm === 'granted' && localStorage.getItem('push_subscribed') === 'true') {
                statusText.textContent = '활성화됨';
                statusText.classList.add('push-status--on');
            } else if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
                statusText.textContent = '앱 설치 후 자동 활성화';
            } else {
                statusText.textContent = '로그인 시 자동 활성화';
            }
        });
    </script>
</DashboardLayout>
