---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import HospitalAutocomplete from '../components/HospitalAutocomplete.astro';
---

<DashboardLayout title="아이디 정하기">
    <style>
        .claim-wrapper {
            max-width: 440px;
            margin: 2rem auto;
            text-align: center;
        }
        .claim-container {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border: 1px solid #e5e7eb;
        }
        h1 {
            margin: 0 0 0.5rem 0;
            font-size: 1.4rem;
            color: var(--accent);
            font-weight: 800;
        }
        .claim-explain {
            color: #4b5563;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1.25rem;
            text-align: left;
        }
        .claim-form {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .claim-form input {
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 1rem;
        }
        .new-member-fields {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .society-select {
            width: 100%;
            box-sizing: border-box;
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 1rem;
            background: white;
            color: inherit;
        }
        .claim-password-hint {
            font-size: 0.8rem;
            color: #6b7280;
            text-align: left;
            margin: 0 0 0.25rem 0;
        }
        .claim-submit-btn {
            background: #111827;
            color: white;
            padding: 0.75rem;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }
        .claim-submit-btn:hover {
            background: #374151;
        }
        .claim-submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .claim-msg {
            font-size: 0.8rem;
            color: #ef4444;
            margin-top: 0.5rem;
        }
        .claim-logout-link {
            margin-top: 1.25rem;
            background: none;
            border: none;
            color: #9ca3af;
            text-decoration: underline;
            font-size: 0.8rem;
            cursor: pointer;
        }
    </style>

    <div class="claim-wrapper">
        <div class="claim-container">
            <h1>아이디를 정해주세요</h1>
            <p class="claim-explain">
                개인정보 보호를 위해 로그인 방식을 바꿨습니다. 앞으로는 실명·이메일 대신
                <strong>아이디</strong>로만 활동합니다. 계속 이용하시려면 아이디를 하나 정해주세요 — 한 번만 하면
                됩니다.
            </p>

            <form id="claimUsernameForm" class="claim-form">
                <input
                    type="text"
                    id="claimUsernameInput"
                    placeholder="아이디 (영문 소문자·숫자·_·- 3~20자)"
                    pattern="[a-z0-9_-]{3,20}"
                    autocomplete="username"
                    required
                />
                <p class="claim-password-hint" id="claimPasswordHint"></p>
                <input
                    type="password"
                    id="claimPasswordInput"
                    placeholder="비밀번호 (8자 이상)"
                    minlength="8"
                    autocomplete="new-password"
                />
                <div id="newMemberFields" class="new-member-fields" hidden>
                    <HospitalAutocomplete />
                    <select id="societySelect" class="society-select">
                        <option value="">소속학회 선택 (선택사항)</option>
                        <option value="nuclear_medicine">대한핵의학회</option>
                        <option value="technology">대한핵의학기술학회</option>
                        <option value="none">비소속</option>
                    </select>
                </div>
                <button type="submit" class="claim-submit-btn" id="claimSubmitBtn">완료하고 계속하기</button>
            </form>
            <p class="claim-msg" id="claimMsg" hidden></p>

            <button type="button" class="claim-logout-link" id="claimLogoutBtn">지금은 로그아웃할게요</button>
        </div>
    </div>

    <script>
        import { supabase } from '../lib/supabase-browser';
        import { userProfile } from '../store/user';

        const form = document.getElementById('claimUsernameForm') as HTMLFormElement;
        const usernameInput = document.getElementById('claimUsernameInput') as HTMLInputElement;
        const passwordInput = document.getElementById('claimPasswordInput') as HTMLInputElement;
        const passwordHint = document.getElementById('claimPasswordHint') as HTMLParagraphElement;
        const submitBtn = document.getElementById('claimSubmitBtn') as HTMLButtonElement;
        const msgEl = document.getElementById('claimMsg') as HTMLParagraphElement;
        const logoutBtn = document.getElementById('claimLogoutBtn') as HTMLButtonElement;
        const newMemberFields = document.getElementById('newMemberFields') as HTMLDivElement;
        const hospitalIdInput = document.getElementById('hospitalId') as HTMLInputElement;
        const societySelect = document.getElementById('societySelect') as HTMLSelectElement;

        const currentUser = userProfile.get();
        const isKakao = currentUser.provider === 'kakao';
        // Phase 2 (2단계 개정 — 2계층+가입승인+제재) — 자가 치유로 막 생긴 진짜 신규
        // 계정만 status 가 'pending'이다. 기존(전환 전) 사용자는 마이그레이션 기본값
        // 'active'를 그대로 갖고 있어 이 필드를 안 본다 — 새 온보딩 질문을 안 늘린다.
        const isNewMember = currentUser.status === 'pending';
        if (isNewMember) newMemberFields.hidden = false;

        // 카카오는 비밀번호 선택(카카오로 계속 로그인 가능), 그 외(이메일 OTP 출신)는
        // 사실상 필수 — OTP 는 Stage C 에서 없어질 예정이라 비밀번호가 유일한 향후 로그인 수단.
        if (isKakao) {
            passwordInput.required = false;
            passwordHint.textContent = '비밀번호(선택) — 정하면 카카오 없이도 아이디/비밀번호로 로그인할 수 있어요.';
        } else {
            passwordInput.required = true;
            passwordHint.textContent =
                '비밀번호(필수) — 이메일 인증 로그인은 곧 없어져서, 비밀번호가 있어야 계속 로그인할 수 있어요.';
        }

        function showError(message: string) {
            msgEl.textContent = message;
            msgEl.hidden = false;
        }

        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = usernameInput.value.trim().toLowerCase();
            const password = passwordInput.value;
            if (!username) return;
            if (!isKakao && !password) {
                showError('비밀번호를 입력해주세요.');
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = '처리 중...';
            msgEl.hidden = true;

            try {
                const { actions } = await import('astro:actions');
                const result = await (actions as any).claimUsername({
                    userId: currentUser.id,
                    username,
                    ...(password ? { password } : {}),
                    // Phase 2 — 신규(pending) 계정일 때만 보낸다. 필드 자체를 안 보내면
                    // 서버가 기존 값을 안 건드린다(.spec/src/actions/index.md 규칙 11).
                    ...(isNewMember
                        ? {
                              hospitalId: hospitalIdInput?.value || '',
                              ...(societySelect?.value ? { society: societySelect.value } : {}),
                          }
                        : {}),
                });
                if (result.error) throw new Error(result.error.message);

                const { getLastRoute } = await import('../lib/last-route');
                const last = getLastRoute();
                window.location.href = last && last.path !== '/' ? last.path : '/mypage';
            } catch (err) {
                showError(err instanceof Error ? err.message : String(err));
                submitBtn.disabled = false;
                submitBtn.textContent = '완료하고 계속하기';
            }
        });

        logoutBtn?.addEventListener('click', async () => {
            await supabase.auth.signOut();
            window.location.href = '/login';
        });
    </script>
</DashboardLayout>
