---
export const prerender = false;

import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
import { createSupabaseServerClient } from '../lib/supabase-server';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
    data: { user },
} = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect('/login');
}

// Fetch user's notifications from database
const { data: notifications } = await supabase
    .from('notifications')
    .select('*')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false });

const notificationList = notifications || [];

// Helper function to format timestamp
function getRelativeTime(timestamp: string): string {
    const now = new Date();
    const then = new Date(timestamp);
    const diffMs = now.getTime() - then.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMins / 60);
    const diffDays = Math.floor(diffHours / 24);

    if (diffMins < 1) return '방금 전';
    if (diffMins < 60) return `${diffMins}분 전`;
    if (diffHours < 24) return `${diffHours}시간 전`;
    if (diffDays < 7) return `${diffDays}일 전`;

    return then.toLocaleDateString('ko-KR');
}

// Determine notification type from title/message
function getNotificationType(title: string): string {
    if (title.includes('취소') || title.includes('❌')) return 'alert';
    if (title.includes('완료') || title.includes('✅')) return 'notice';
    if (title.includes('변경') || title.includes('⚠️')) return 'alert';
    return 'info';
}
---

<DashboardLayout title="알림함">
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
        }
        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .mark-read-btn {
            font-size: 0.85rem;
            color: var(--accent);
            background: none;
            border: none;
            cursor: pointer;
            font-weight: 500;
        }
        .mark-read-btn:hover {
            text-decoration: underline;
        }

        .notification-list {
            display: flex;
            flex-direction: column;
        }

        .notification-item {
            display: flex;
            gap: 1rem;
            padding: 1.25rem;
            border-bottom: 1px solid var(--border-color);
            transition: background 0.2s;
            cursor: pointer;
            position: relative;
        }
        .notification-item:hover {
            background: var(--bg-card);
        }
        .notification-item.unread {
            background: rgba(37, 99, 235, 0.05); /* Soft Blue Tint */
        }
        .notification-item.unread:hover {
            background: rgba(37, 99, 235, 0.1);
        }

        .noti-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            flex-shrink: 0;
        }

        /* Icon Colors per type */
        .notification-item.type-alert .noti-icon {
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.3);
            background: rgba(239, 68, 68, 0.1);
        }
        .notification-item.type-notice .noti-icon {
            color: #2563eb;
            border-color: rgba(37, 99, 235, 0.3);
            background: rgba(37, 99, 235, 0.1);
        }
        .notification-item.type-info .noti-icon {
            color: #10b981;
        }

        .noti-content {
            flex: 1;
        }
        .noti-title {
            font-size: 0.95rem;
            color: var(--text-main);
            margin-bottom: 0.25rem;
            line-height: 1.4;
        }
        .notification-item.unread .noti-title {
            font-weight: 600;
        }
        .noti-message {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            line-height: 1.5;
            white-space: pre-line;
        }
        .noti-time {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .unread-dot {
            position: absolute;
            top: 1.5rem;
            right: 1rem;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border-radius: 50%;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 1rem;
            color: var(--text-muted);
        }
    </style>

    <div class="page-header">
        <div class="page-title">
            <Icon name="bell" size="28" /> 알림함
        </div>
        <button class="mark-read-btn">모두 읽음으로 표시</button>
    </div>

    <div class="notification-list">
        {
            notificationList.length === 0 ? (
                <div class="empty-state">
                    <Icon name="bell" size="48" />
                    <p style="margin-top: 1rem;">알림이 없습니다.</p>
                </div>
            ) : (
                notificationList.map((noti) => {
                    const notiType = getNotificationType(noti.title || '');
                    return (
                        <div
                            class={`notification-item ${noti.is_read ? '' : 'unread'} type-${notiType}`}
                            data-id={noti.id}
                            data-link={noti.link || ''}
                        >
                            <div class="noti-icon">
                                <Icon
                                    name={
                                        notiType === 'alert'
                                            ? 'bell'
                                            : notiType === 'notice'
                                              ? 'document-text'
                                              : 'clipboard'
                                    }
                                    size="20"
                                />
                            </div>
                            <div class="noti-content">
                                <div class="noti-title">{noti.title || '알림'}</div>
                                {noti.message && noti.title && <div class="noti-message">{noti.message}</div>}
                                <div class="noti-time">{getRelativeTime(noti.created_at)}</div>
                            </div>
                            {!noti.is_read && <div class="unread-dot" />}
                        </div>
                    );
                })
            )
        }
    </div>
    <script>
        import { supabase } from '../lib/supabase-browser';

        console.log('🔔 Notifications page script loaded');

        document.addEventListener('astro:page-load', () => {
            console.log('🔔 Notifications astro:page-load fired');
            initNotifications();
        });

        if (document.readyState !== 'loading') {
            initNotifications();
        }

        async function markAllAsRead() {
            const unreadItems = document.querySelectorAll('.notification-item.unread');
            const unreadIds = Array.from(unreadItems).map((item) => (item as HTMLElement).dataset.id);

            if (unreadIds.length === 0) return false;

            const { error } = await supabase.from('notifications').update({ is_read: true }).in('id', unreadIds);

            if (error) {
                console.error('Failed to mark as read:', error);
                return false;
            }

            return true;
        }

        async function markAsRead(notificationId: string) {
            const { error } = await supabase.from('notifications').update({ is_read: true }).eq('id', notificationId);

            if (error) {
                console.error('Failed to mark notification as read:', error);
                return false;
            }

            return true;
        }

        function initNotifications() {
            const markReadBtn = document.querySelector('.mark-read-btn');

            // Mark all as read button
            markReadBtn?.addEventListener('click', async () => {
                const unreadCount = document.querySelectorAll('.notification-item.unread').length;

                if (unreadCount === 0) {
                    alert('읽지 않은 알림이 없습니다.');
                    return;
                }

                if (confirm('모든 알림을 읽음으로 표시하시겠습니까?')) {
                    const success = await markAllAsRead();

                    if (success) {
                        // Update UI
                        const items = document.querySelectorAll('.notification-item.unread');
                        const dots = document.querySelectorAll('.unread-dot');

                        items.forEach((item) => item.classList.remove('unread'));
                        dots.forEach((dot) => ((dot as HTMLElement).style.display = 'none'));

                        // Update Global Header Badge
                        const globalDots = document.querySelectorAll('.global-noti-dot');
                        globalDots.forEach((d) => ((d as HTMLElement).style.display = 'none'));

                        alert('모든 알림을 읽음으로 표시했습니다.');
                    } else {
                        alert('알림 업데이트에 실패했습니다.');
                    }
                }
            });

            // Handle Individual Item Click
            const allItems = document.querySelectorAll('.notification-item');
            allItems.forEach((item) => {
                item.addEventListener('click', async () => {
                    const itemEl = item as HTMLElement;
                    const notificationId = itemEl.dataset.id;
                    const link = itemEl.dataset.link;

                    // Mark as read if unread
                    if (item.classList.contains('unread') && notificationId) {
                        const success = await markAsRead(notificationId);

                        if (success) {
                            item.classList.remove('unread');
                            const dot = item.querySelector('.unread-dot');
                            if (dot) (dot as HTMLElement).style.display = 'none';

                            // Check if ANY unread remain
                            const remaining = document.querySelectorAll('.notification-item.unread').length;
                            if (remaining === 0) {
                                const globalDots = document.querySelectorAll('.global-noti-dot');
                                globalDots.forEach((d) => ((d as HTMLElement).style.display = 'none'));
                            }
                        }
                    }

                    // Navigate to link if exists
                    if (link) {
                        window.location.href = link;
                    }
                });
            });
        }
    </script>
</DashboardLayout>
