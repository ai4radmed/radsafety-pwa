---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
import HospitalAutocomplete from '../components/HospitalAutocomplete.astro';

// 마이페이지. 명세: .spec/src/pages/mypage.md
// 2단계 2-2(documents/privacy_redesign_plan.md, 2026-09-19): 카드 1(배지·아이디·가입일) +
// 카드 2(소속 정보 — 기관·학회, 편집 가능) + 회원 탈퇴. 옛 인증요청 UI·안전관리면허 카드 삭제.
---

<DashboardLayout title="마이페이지">
    <style>
        .mypage-container {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            padding-bottom: 4rem;
        }
        .info-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .identity-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            width: 100%;
            justify-content: space-between;
        }
        .card-title {
            margin: 0;
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-main);
        }
        .card-desc {
            margin: 0;
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.5;
        }
        .affiliation-form {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .affiliation-form label {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .society-select {
            width: 100%;
            box-sizing: border-box;
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 1rem;
        }
        .save-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-top: 0.25rem;
        }
        .save-btn {
            background: #111827;
            color: white;
            padding: 0.6rem 1.2rem;
            border: none;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
        }
        .save-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .save-msg {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .request-note {
            font-size: 0.8rem;
            color: #f59e0b;
            margin: 0;
        }
    </style>

    <div class="mypage-container">
        <!-- 1. Identity -->
        <div class="info-card">
            <div class="identity-header">
                <div id="loginBadge" class="login-badge email-badge">
                    <Icon name="user" size="14" />
                    <span>로그인 중</span>
                </div>
                <div
                    id="adminBadge"
                    style="display:none; font-size:0.75rem; background:#ef4444; color:white; padding:0.15rem 0.5rem; border-radius:12px; font-weight:bold; letter-spacing:0.5px;"
                >
                    ADMIN
                </div>
            </div>
            <div
                style="margin-top:0.5rem; font-size:0.9rem; color:var(--text-main); display:flex; justify-content:space-between; align-items:center;"
            >
                <span id="userIdentityName" style="font-weight:700;">...</span>
                <span style="color:#6b7280; font-size:0.85rem;"
                    >가입일: <span id="userJoinedAt" style="font-weight:500;">...</span></span
                >
            </div>
        </div>

        <!-- 2. Affiliation -->
        <div class="info-card">
            <h3 class="card-title">소속 정보</h3>
            <p class="card-desc">
                소속기관과 소속학회는 선택 항목이며 본인 마이페이지와 관리자 화면에서만 보입니다. 작성자 표시·자료
                목록에는 아이디만 쓰입니다.
            </p>
            <p id="hospitalRequestNote" class="request-note" hidden></p>
            <p class="card-desc">
                업로드 권한: <strong id="userPublishStatus" style="color:var(--text-main);">-</strong>
            </p>
            <div class="affiliation-form">
                <label for="hospitalQuery">소속기관</label>
                <HospitalAutocomplete />
                <label for="societySelect">소속학회</label>
                <select id="societySelect" class="society-select">
                    <option value="">소속학회 선택 (선택사항)</option>
                    <option value="nuclear_medicine">대한핵의학회</option>
                    <option value="technology">대한핵의학기술학회</option>
                    <option value="none">비소속</option>
                </select>
                <div class="save-row">
                    <button type="button" id="saveAffiliationBtn" class="save-btn">저장</button>
                    <span id="saveAffiliationMsg" class="save-msg"></span>
                </div>
            </div>
        </div>

        <!-- 3. Delete Account -->
        <div style="margin-top: 2rem; text-align: center; border-top: 1px solid #eee; padding-top: 1rem;">
            <button
                id="deleteAccountBtn"
                style="background: none; border: none; color: #9ca3af; text-decoration: underline; cursor: pointer; font-size: 0.8rem;"
            >
                회원 탈퇴
            </button>
        </div>
    </div>

    <script>
        import { userProfile } from '../store/user';
        import { supabase } from '../lib/supabase-browser';
        import { deleteOwnAccount } from '../lib/delete-account';
        import { HOSPITALS } from '../data/hospitals';

        const KAKAO_BADGE = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.48 3 2 6.48 2 10.76c0 2.76 1.87 5.2 4.76 6.55-.21.78-.77 2.82-.88 3.23-.14.53.19.52.4.34.17-.14 2.65-1.8 3.71-2.53.64.09 1.31.14 2.01.14 5.52 0 10-3.48 10-7.76S17.52 3 12 3z"/></svg> <span>카카오 로그인 중</span>`;
        const ID_BADGE = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg> <span>아이디 로그인 중</span>`;

        // 정적 목록 → 관리자가 등록한 hospitals_custom(c- 접두) 순으로 이름 해석.
        async function resolveHospitalName(hospitalId: string): Promise<string> {
            const found = HOSPITALS.find((h) => h.id === hospitalId)?.name;
            if (found) return found;
            if (hospitalId.startsWith('c-')) {
                try {
                    const { data } = await supabase
                        .from('hospitals_custom')
                        .select('name')
                        .eq('id', hospitalId)
                        .maybeSingle();
                    if (data?.name) return data.name as string;
                } catch {
                    // 폴백
                }
            }
            return hospitalId;
        }

        document.addEventListener('astro:page-load', () => {
            const hospitalQuery = document.getElementById('hospitalQuery') as HTMLInputElement | null;
            const hospitalIdInput = document.getElementById('hospitalId') as HTMLInputElement | null;
            const hospitalRequestInput = document.getElementById('hospitalRequest') as HTMLInputElement | null;
            const requestNote = document.getElementById('hospitalRequestNote') as HTMLParagraphElement | null;
            const societySelect = document.getElementById('societySelect') as HTMLSelectElement | null;
            const saveBtn = document.getElementById('saveAffiliationBtn') as HTMLButtonElement | null;
            const saveMsg = document.getElementById('saveAffiliationMsg') as HTMLSpanElement | null;

            let prefilledFor: string | null = null;

            userProfile.subscribe(async (currentUser: any) => {
                if (!currentUser.id) return;

                // --- 카드 1 ---
                const loginBadge = document.getElementById('loginBadge');
                if (loginBadge) {
                    const kakao = currentUser.provider === 'kakao';
                    loginBadge.classList.toggle('kakao-badge', kakao);
                    loginBadge.classList.toggle('email-badge', !kakao);
                    loginBadge.innerHTML = kakao ? KAKAO_BADGE : ID_BADGE;
                }
                const nameEl = document.getElementById('userIdentityName');
                if (nameEl) nameEl.textContent = currentUser.username ? `@${currentUser.username}` : '(아이디 미설정)';
                const dateEl = document.getElementById('userJoinedAt');
                if (dateEl) {
                    dateEl.textContent = currentUser.created_at
                        ? new Date(currentUser.created_at).toLocaleDateString('ko-KR')
                        : '-';
                }
                const adminBadge = document.getElementById('adminBadge');
                if (adminBadge) adminBadge.style.display = String(currentUser.is_admin) === 'true' ? 'block' : 'none';

                // 2-1 업로드 권한(계획서 2-2 카드 2 "업로드 권한" 행)
                const publishEl = document.getElementById('userPublishStatus');
                if (publishEl) {
                    const rejected = Number(currentUser.reject_count || 0);
                    publishEl.textContent =
                        String(currentUser.is_admin) === 'true'
                            ? '관리자 — 바로 게시'
                            : rejected >= 3
                              ? `제출 차단 (반려 ${rejected}회 누적)`
                              : currentUser.can_publish === 'true'
                                ? '직접 게시 가능'
                                : rejected > 0
                                  ? `첫 제출 검토 대기 (반려 ${rejected}회)`
                                  : '첫 제출 검토 대기';
                }

                // --- 카드 2 프리필 (계정당 1회 — 사용자가 편집 중인 값을 스토어 갱신이 덮지 않도록) ---
                if (prefilledFor === currentUser.id) return;
                prefilledFor = currentUser.id;

                if (societySelect) societySelect.value = currentUser.society || '';

                const hospitalId: string | null = currentUser.hospital_id || null;
                if (hospitalQuery && hospitalIdInput && hospitalRequestInput) {
                    if (hospitalId && hospitalId !== 'other') {
                        hospitalQuery.value = await resolveHospitalName(hospitalId);
                        hospitalIdInput.value = hospitalId;
                        hospitalRequestInput.value = '';
                    } else if (currentUser.hospital_request) {
                        hospitalQuery.value = currentUser.hospital_request;
                        hospitalIdInput.value = '';
                        hospitalRequestInput.value = currentUser.hospital_request;
                    } else {
                        hospitalQuery.value = hospitalId === 'other' ? '기타' : '';
                        hospitalIdInput.value = hospitalId === 'other' ? 'other' : '';
                        hospitalRequestInput.value = '';
                    }
                }
                if (requestNote) {
                    if (currentUser.hospital_request) {
                        requestNote.textContent = `「${currentUser.hospital_request}」 등록 요청이 관리자 검토 중입니다. 등록되면 알림으로 알려드려요.`;
                        requestNote.hidden = false;
                    } else {
                        requestNote.hidden = true;
                    }
                }
            });

            saveBtn?.addEventListener('click', async () => {
                const currentUser = userProfile.get() as any;
                if (!currentUser.id || !saveBtn) return;
                saveBtn.disabled = true;
                if (saveMsg) saveMsg.textContent = '저장 중...';
                try {
                    const { actions } = await import('astro:actions');
                    const hospitalId = hospitalIdInput?.value || '';
                    const hospitalRequest = hospitalRequestInput?.value || '';
                    const result = await (actions as any).updateAffiliation({
                        userId: currentUser.id,
                        hospitalId,
                        ...(hospitalRequest ? { hospitalRequest } : {}),
                        ...(societySelect?.value ? { society: societySelect.value } : { society: null }),
                    });
                    if (result.error) throw new Error(result.error.message);
                    userProfile.set({
                        ...currentUser,
                        hospital_id: result.data.hospital_id ?? '',
                        hospital_request: result.data.hospital_request ?? '',
                        society: result.data.society ?? '',
                    });
                    prefilledFor = null; // 저장값으로 다시 프리필
                    if (saveMsg) saveMsg.textContent = '저장되었습니다.';
                } catch (err) {
                    if (saveMsg)
                        saveMsg.textContent = '저장 실패: ' + (err instanceof Error ? err.message : String(err));
                } finally {
                    saveBtn.disabled = false;
                }
            });

            // Delete Account (명세: .spec/src/pages/mypage.md)
            document.getElementById('deleteAccountBtn')?.addEventListener('click', async () => {
                if (
                    !confirm(
                        "정말로 탈퇴하시겠습니까?\n\n- 계정 정보는 즉시 삭제됩니다.\n- 작성하신 게시글(지적/권고, 자료실 등)은 '알 수 없음'으로 남게 됩니다.\n- 이 작업은 되돌릴 수 없습니다.",
                    )
                )
                    return;

                try {
                    const { error } = await deleteOwnAccount(supabase);
                    if (error) throw error;

                    await supabase.auth.signOut();
                    alert('탈퇴가 완료되었습니다. 이용해 주셔서 감사합니다.');
                    window.location.href = '/';
                } catch (err) {
                    console.error(err);
                    alert('탈퇴 처리 중 오류가 발생했습니다: ' + (err as Error).message);
                }
            });
        });
    </script>
</DashboardLayout>
