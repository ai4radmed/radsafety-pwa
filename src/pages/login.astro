---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import LoginButton from '../components/auth/LoginButton.astro';
import EmailOtpForm from '../components/auth/EmailOtpForm.astro';

const isDevMode = import.meta.env.PUBLIC_DEV_MODE === 'true';
const devUserEmail = import.meta.env.DEV_TEST_USER_EMAIL ?? '';
const devUserPassword = import.meta.env.DEV_TEST_USER_PASSWORD ?? '';
const devAdminEmail = import.meta.env.DEV_TEST_ADMIN_EMAIL ?? '';
const devAdminPassword = import.meta.env.DEV_TEST_ADMIN_PASSWORD ?? '';
---

<DashboardLayout title="간편인증으로 시작하기">
    <style>
        .login-wrapper {
            max-width: 440px;
            margin: 1rem auto; /* 바짝 붙임 */
            text-align: center;
        }
        .login-container {
            background: white;
            padding: 1.25rem; /* Reduced padding */
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border: 1px solid #e5e7eb;
        }
        h1 {
            margin-bottom: 0.25rem;
            font-size: 1.5rem; /* Smaller */
            color: var(--accent);
            font-weight: 800;
        }
        p.subtitle {
            color: #6b7280;
            margin-bottom: 1rem; /* Reduced */
            font-size: 0.85rem;
        }
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 0.75rem 0; /* Tightened */
            color: #9ca3af;
            font-size: 0.8rem;
        }
        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e5e7eb;
        }
        .divider::before {
            margin-right: 0.5em;
        }
        .divider::after {
            margin-left: 0.5em;
        }

        .test-login {
            margin-top: 1rem;
            padding: 0.5rem;
            background: #f3f4f6;
            border-radius: 4px;
            font-size: 0.85rem;
            color: #4b5563;
        }
        .dev-btn {
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .dev-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .sns-buttons {
            margin-top: 1rem;
        }
    </style>

    <div class="login-wrapper">
        <div class="login-container">
            <!-- SNS Buttons Wrapper -->
            <div class="sns-buttons">
                <LoginButton
                    provider="kakao"
                    label="카카오 인증으로 RadSafety 시작하기"
                    color="#FEE500"
                    textColor="#000000"
                />
            </div>

            <div class="divider">또는 이메일 인증으로 시작하기</div>

            <EmailOtpForm />

            {
                isDevMode && (
                    <>
                        <div class="divider">개발용 기능</div>
                        <div
                            class="test-login"
                            id="devLoginPanel"
                            data-user-email={devUserEmail}
                            data-user-password={devUserPassword}
                            data-admin-email={devAdminEmail}
                            data-admin-password={devAdminPassword}
                        >
                            <div style="margin-bottom:0.5rem;">[개발자 모드]</div>
                            <div style="display: flex; flex-wrap: wrap; gap: 5px; justify-content: center;">
                                <button id="devLoginUserBtn" class="dev-btn" style="background:#4b5563; color:white;">
                                    테스트 사용자 로그인
                                </button>
                                <button id="devLoginAdminBtn" class="dev-btn" style="background:#059669; color:white;">
                                    테스트 관리자 로그인
                                </button>
                            </div>
                        </div>
                    </>
                )
            }
        </div>

        <!-- [SESSION-DIAG] start: 진단 패널 -->
        <details id="diagPanel" class="diag-panel">
            <summary class="diag-summary">세션 진단 로그</summary>
            <div id="diagState" class="diag-state"></div>
            <div id="diagLogs" class="diag-logs">로딩 중...</div>
            <button id="diagClearBtn" class="diag-clear-btn">로그 전체 삭제</button>
        </details>
        <!-- [SESSION-DIAG] end -->
    </div>

    <!-- [SESSION-DIAG] start: 진단 패널 스타일 -->
    <style>
        .diag-panel {
            margin-top: 1rem;
            padding: 0.75rem;
            background: #1a1a2e;
            border-radius: 8px;
            color: #e0e0e0;
            font-family: monospace;
            font-size: 0.65rem;
        }
        .diag-summary {
            cursor: pointer;
            color: #00d4ff;
            font-weight: bold;
            font-size: 0.75rem;
        }
        .diag-state {
            margin: 0.5rem 0;
            padding: 0.5rem;
            background: #16213e;
            border-radius: 4px;
            line-height: 1.6;
        }
        .diag-state .miss {
            color: #e74c3c;
        }
        .diag-state .hit {
            color: #2ecc71;
        }
        .diag-logs {
            max-height: 300px;
            overflow-y: auto;
            padding: 0.5rem;
            background: #0f0f23;
            border-radius: 4px;
            line-height: 1.5;
        }
        .diag-logs .log-ts {
            color: #666;
        }
        .diag-logs .log-pt {
            color: #00d4ff;
        }
        .diag-logs .log-row {
            border-bottom: 1px solid #1a1a2e;
            padding: 2px 0;
        }
        .diag-clear-btn {
            margin-top: 0.5rem;
            padding: 0.25rem 0.5rem;
            background: #e74c3c;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 0.6rem;
            cursor: pointer;
        }
    </style>
    <!-- [SESSION-DIAG] end -->

    <script>
        import { supabase } from '../lib/supabase-browser';

        // 개발자 모드: 테스트 계정 로그인 (signInWithPassword)
        const devPanel = document.getElementById('devLoginPanel');
        if (devPanel) {
            const devLogin = async (email: string, password: string, label: string) => {
                // 환경변수 미설정 시 빈 문자열로 Supabase 호출하는 것을 사전 차단
                if (!email || !password) {
                    alert(
                        `[개발자 모드] ${label === 'user' ? 'DEV_TEST_USER' : 'DEV_TEST_ADMIN'}_EMAIL/PASSWORD 환경변수가 설정되지 않았습니다.\n.env 파일을 확인하세요.`,
                    );
                    return;
                }

                const btn = document.getElementById(
                    label === 'user' ? 'devLoginUserBtn' : 'devLoginAdminBtn',
                ) as HTMLButtonElement | null;
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = '로그인 중...';
                }
                try {
                    const { error } = await supabase.auth.signInWithPassword({ email, password });
                    if (error) throw error;
                    window.location.href = '/mypage';
                } catch (err) {
                    alert('개발자 로그인 오류: ' + (err instanceof Error ? err.message : String(err)));
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = label === 'user' ? '테스트 사용자 로그인' : '테스트 관리자 로그인';
                    }
                }
            };

            const userEmail = devPanel.dataset.userEmail ?? '';
            const userPassword = devPanel.dataset.userPassword ?? '';
            const adminEmail = devPanel.dataset.adminEmail ?? '';
            const adminPassword = devPanel.dataset.adminPassword ?? '';

            document
                .getElementById('devLoginUserBtn')
                ?.addEventListener('click', () => devLogin(userEmail, userPassword, 'user'));
            document
                .getElementById('devLoginAdminBtn')
                ?.addEventListener('click', () => devLogin(adminEmail, adminPassword, 'admin'));
        }

        // OAuth: LoginButton 클릭 시 signInWithOAuth
        const btns = document.querySelectorAll('.login-btn');
        btns.forEach((btn) => {
            btn.addEventListener('click', async () => {
                const provider = (btn as HTMLElement).dataset.provider as any;
                const { error } = await supabase.auth.signInWithOAuth({
                    provider: provider,
                    options: {
                        redirectTo: `${window.location.origin}/auth/callback`,
                        // Force override scope using queryParams (Supabase sometimes ignores 'scopes' prop)
                        queryParams: {
                            scope: 'account_email,profile_nickname', // Request Email explicitly!
                        },
                    },
                });
                if (error) alert('로그인 오류: ' + error.message);
            });
        });
    </script>

    <!-- [SESSION-DIAG] start: 진단 패널 로직 -->
    <script>
        import { getDiagLogs, clearDiagLogs } from '../lib/session-diag';

        function renderDiagPanel() {
            const panel = document.getElementById('diagPanel');
            if (!panel) return;

            const stateEl = document.getElementById('diagState');
            if (stateEl) {
                const hasSbCookie = document.cookie.includes('sb-');
                const lsBackup = localStorage.getItem('sb-cookie-backup');
                const lastRoute = localStorage.getItem('last_route');
                const isStandalone = window.matchMedia('(display-mode: standalone)').matches;
                const cls = (ok: boolean) => (ok ? 'hit' : 'miss');
                stateEl.innerHTML =
                    `<div>Cookie(sb-): <span class="${cls(hasSbCookie)}">${hasSbCookie ? 'O' : 'X'}</span></div>` +
                    `<div>LS backup: <span class="${cls(!!lsBackup)}">${lsBackup ? 'O' : 'X'}</span></div>` +
                    `<div>last_route: <span class="${cls(!!lastRoute)}">${lastRoute ?? 'X'}</span></div>` +
                    `<div>Standalone: ${isStandalone ? 'YES' : 'NO'}</div>`;
            }

            const logsEl = document.getElementById('diagLogs');
            if (logsEl) {
                getDiagLogs().then((logs) => {
                    if (logs.length === 0) {
                        logsEl.textContent = '(로그 없음 - IndexedDB 비어있음)';
                        return;
                    }
                    logsEl.innerHTML = logs
                        .slice(-50)
                        .reverse()
                        .map(
                            (l) =>
                                `<div class="log-row"><span class="log-ts">${l.ts.slice(11, 19)}</span> <span class="log-pt">${l.point}</span> ${JSON.stringify(l.data)}</div>`,
                        )
                        .join('');
                });
            }

            document.getElementById('diagClearBtn')?.addEventListener('click', async () => {
                await clearDiagLogs();
                if (logsEl) logsEl.textContent = '(삭제됨)';
            });
        }

        document.addEventListener('astro:page-load', renderDiagPanel);
    </script>
    <!-- [SESSION-DIAG] end -->
</DashboardLayout>
