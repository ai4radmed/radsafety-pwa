---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
---

<DashboardLayout title="용어 관리">
    <style>
        .glossary-container {
            max-width: 1400px;
            margin: 0 auto;
        }
        .page-header {
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .btn {
            padding: 0.65rem 1.25rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-primary {
            background: var(--accent);
            color: white;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .btn-secondary {
            background: var(--bg-body);
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }
        .btn-secondary:hover {
            background: var(--border-color);
        }
        .btn-danger {
            background: #ef4444;
            color: white;
        }
        .btn-danger:hover {
            background: #dc2626;
        }
        .btn-sm {
            padding: 0.4rem 0.75rem;
            font-size: 0.8rem;
        }

        /* Table */
        .glossary-table-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }
        .glossary-table {
            width: 100%;
            border-collapse: collapse;
        }
        .glossary-table thead {
            background: var(--bg-body);
            border-bottom: 2px solid var(--border-color);
        }
        .glossary-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        .glossary-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: background-color 0.2s;
        }
        .glossary-table tbody tr:hover {
            background: var(--bg-hover);
        }
        .glossary-table tbody tr:last-child {
            border-bottom: none;
        }
        .glossary-table td {
            padding: 1rem;
            color: var(--text-main);
            font-size: 0.95rem;
        }
        .term-name {
            font-weight: 700;
        }
        .term-category {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 600;
            background: var(--bg-sidebar);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
        }
        .term-def-preview {
            max-width: 400px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        .action-btns {
            display: flex;
            gap: 0.5rem;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: var(--text-muted);
        }

        /* Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-backdrop.active {
            display: flex;
        }
        .modal-content {
            background: var(--bg-card);
            border-radius: 12px;
            max-width: 600px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }
        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0.25rem;
        }
        .modal-body {
            padding: 1.5rem;
        }
        .modal-footer {
            padding: 1.5rem;
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }
        .form-label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .form-input,
        .form-textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-body);
            color: var(--text-main);
            font-family: inherit;
            font-size: 0.95rem;
            box-sizing: border-box;
        }
        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: var(--accent);
        }
        .form-textarea {
            min-height: 120px;
            resize: vertical;
        }

        .sort-order-input {
            width: 80px;
        }

        @media (max-width: 768px) {
            .glossary-table th:nth-child(3),
            .glossary-table td:nth-child(3) {
                display: none;
            }
            .term-def-preview {
                max-width: 200px;
            }
        }
    </style>

    <div class="glossary-container">
        <div class="page-header">
            <div>
                <h1 class="page-title">
                    <Icon name="book" size="32" /> 용어 관리
                </h1>
                <p class="page-subtitle">법령용어사전의 용어를 추가, 수정, 삭제할 수 있습니다.</p>
            </div>
            <button class="btn btn-primary" id="addTermBtn"> + 용어 추가 </button>
        </div>

        <!-- Glossary Table -->
        <div class="glossary-table-container">
            <table class="glossary-table">
                <thead>
                    <tr>
                        <th>순서</th>
                        <th>용어명</th>
                        <th>카테고리</th>
                        <th>정의</th>
                        <th>관리</th>
                    </tr>
                </thead>
                <tbody id="glossaryTableBody">
                    <tr>
                        <td colspan="5" class="empty-state">로딩 중...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div id="termModal" class="modal-backdrop">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modalTitle">용어 추가</h2>
                <button class="modal-close" id="closeModal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="termId" />
                <div class="form-group">
                    <label class="form-label" for="termName">용어명 *</label>
                    <input type="text" class="form-input" id="termName" placeholder="용어를 입력하세요" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="termDefinition">정의 *</label>
                    <textarea class="form-textarea" id="termDefinition" placeholder="용어의 정의를 입력하세요"
                    ></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label" for="termCategory">카테고리</label>
                    <input type="text" class="form-input" id="termCategory" placeholder="예: 인물/자격, 측정, 행정" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="termSortOrder">정렬 순서</label>
                    <input type="number" class="form-input sort-order-input" id="termSortOrder" value="0" min="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="cancelBtn">취소</button>
                <button class="btn btn-primary" id="saveBtn">저장</button>
            </div>
        </div>
    </div>

    <script>
        import { supabase } from '../../lib/supabase-browser';
        import { userProfile } from '../../store/user';

        // Guard: Admin only
        const user = userProfile.get();
        if (user.is_admin !== 'true') {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/';
        }

        interface GlossaryTerm {
            id: string;
            term: string;
            definition: string;
            category: string | null;
            sort_order: number;
            created_at: string;
            updated_at: string;
        }

        let allTerms: GlossaryTerm[] = [];
        let editingId: string | null = null;

        const tableBody = document.getElementById('glossaryTableBody');
        const modal = document.getElementById('termModal');
        const modalTitle = document.getElementById('modalTitle');
        const closeModalBtn = document.getElementById('closeModal');
        const addTermBtn = document.getElementById('addTermBtn');
        const cancelBtn = document.getElementById('cancelBtn');
        const saveBtn = document.getElementById('saveBtn');

        const termIdInput = document.getElementById('termId') as HTMLInputElement;
        const termNameInput = document.getElementById('termName') as HTMLInputElement;
        const termDefinitionInput = document.getElementById('termDefinition') as HTMLTextAreaElement;
        const termCategoryInput = document.getElementById('termCategory') as HTMLInputElement;
        const termSortOrderInput = document.getElementById('termSortOrder') as HTMLInputElement;

        // Load terms from database
        async function loadTerms() {
            try {
                const { data, error } = await supabase.from('glossary_terms').select('*').order('sort_order');

                if (error) throw error;

                allTerms = data || [];
                renderTable();
            } catch (error) {
                console.error('Failed to load glossary terms:', error);
                if (tableBody) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="empty-state">
                                데이터를 불러오는데 실패했습니다.
                            </td>
                        </tr>
                    `;
                }
            }
        }

        // Render table
        function renderTable() {
            if (!tableBody) return;

            if (allTerms.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="empty-state">
                            등록된 용어가 없습니다. "용어 추가" 버튼을 클릭하여 추가하세요.
                        </td>
                    </tr>
                `;
                return;
            }

            tableBody.innerHTML = allTerms
                .map(
                    (term) => `
                <tr data-id="${term.id}">
                    <td>${term.sort_order}</td>
                    <td><span class="term-name">${escapeHtml(term.term)}</span></td>
                    <td>${term.category ? `<span class="term-category">${escapeHtml(term.category)}</span>` : '-'}</td>
                    <td><div class="term-def-preview">${escapeHtml(term.definition)}</div></td>
                    <td>
                        <div class="action-btns">
                            <button class="btn btn-secondary btn-sm edit-btn" data-id="${term.id}">수정</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${term.id}">삭제</button>
                        </div>
                    </td>
                </tr>
            `,
                )
                .join('');

            // Attach edit handlers
            tableBody.querySelectorAll('.edit-btn').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const id = (btn as HTMLElement).dataset.id;
                    const term = allTerms.find((t) => t.id === id);
                    if (term) openEditModal(term);
                });
            });

            // Attach delete handlers
            tableBody.querySelectorAll('.delete-btn').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const id = (btn as HTMLElement).dataset.id;
                    if (id) deleteTerm(id);
                });
            });
        }

        function escapeHtml(text: string): string {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Open modal for adding
        function openAddModal() {
            editingId = null;
            if (modalTitle) modalTitle.textContent = '용어 추가';
            termIdInput.value = '';
            termNameInput.value = '';
            termDefinitionInput.value = '';
            termCategoryInput.value = '';
            // Set next sort_order
            const maxOrder = allTerms.reduce((max, t) => Math.max(max, t.sort_order || 0), 0);
            termSortOrderInput.value = String(maxOrder + 1);
            modal?.classList.add('active');
            termNameInput.focus();
        }

        // Open modal for editing
        function openEditModal(term: GlossaryTerm) {
            editingId = term.id;
            if (modalTitle) modalTitle.textContent = '용어 수정';
            termIdInput.value = term.id;
            termNameInput.value = term.term;
            termDefinitionInput.value = term.definition;
            termCategoryInput.value = term.category || '';
            termSortOrderInput.value = String(term.sort_order || 0);
            modal?.classList.add('active');
            termNameInput.focus();
        }

        // Close modal
        function closeModal() {
            modal?.classList.remove('active');
            editingId = null;
        }

        // Save term (create or update)
        async function saveTerm() {
            const term = termNameInput.value.trim();
            const definition = termDefinitionInput.value.trim();
            const category = termCategoryInput.value.trim() || null;
            const sort_order = parseInt(termSortOrderInput.value) || 0;

            if (!term || !definition) {
                alert('용어명과 정의는 필수입니다.');
                return;
            }

            try {
                if (editingId) {
                    // Update
                    const { error } = await supabase
                        .from('glossary_terms')
                        .update({ term, definition, category, sort_order, updated_at: new Date().toISOString() })
                        .eq('id', editingId);

                    if (error) throw error;
                    alert('용어가 수정되었습니다.');
                } else {
                    // Insert
                    const { error } = await supabase
                        .from('glossary_terms')
                        .insert({ term, definition, category, sort_order });

                    if (error) throw error;
                    alert('용어가 추가되었습니다.');
                }

                closeModal();
                loadTerms();
            } catch (error) {
                console.error('Failed to save term:', error);
                alert('저장에 실패했습니다.');
            }
        }

        // Delete term
        async function deleteTerm(id: string) {
            const term = allTerms.find((t) => t.id === id);
            if (!term) return;

            if (!confirm(`"${term.term}" 용어를 삭제하시겠습니까?`)) {
                return;
            }

            try {
                const { error } = await supabase.from('glossary_terms').delete().eq('id', id);

                if (error) throw error;

                alert('용어가 삭제되었습니다.');
                loadTerms();
            } catch (error) {
                console.error('Failed to delete term:', error);
                alert('삭제에 실패했습니다.');
            }
        }

        // Event listeners
        addTermBtn?.addEventListener('click', openAddModal);
        closeModalBtn?.addEventListener('click', closeModal);
        cancelBtn?.addEventListener('click', closeModal);
        saveBtn?.addEventListener('click', saveTerm);

        // Close modal on backdrop click
        modal?.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        // Initial load
        loadTerms();
    </script>
</DashboardLayout>
