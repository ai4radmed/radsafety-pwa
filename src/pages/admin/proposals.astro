---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';

// 제안 검토(관리자). 명세: .spec/src/pages/admin/proposals.md
// 3단계(2026-09-20): 목록·상태·메모·답변·삭제. 익명 행은 작성자 열이 비어 있고 관리자는 누구에게 답하는지 모른 채 답한다.
// 가치 있는 제안은 특정 정보를 지운 뒤 지적권고사례로 옮겨 적는 수동 단계(자동 이관 ✗).
export const prerender = false;
---

<DashboardLayout title="제안 검토">
    <div class="padmin">
        <div class="header">
            <div class="page-title"><Icon name="pencil" size="24" /> 제도 개선 제안 검토</div>
            <p class="subtitle">
                <strong>익명</strong> 제안은 작성자 정보가 없습니다(기록하지 않음). 답변을 저장하고 상태를 <strong
                    >답변 완료</strong
                >로 바꾸면 아이디 제안자는 알림을, 익명 제안자는 접수증 코드로 확인합니다. 공개할 가치가 있는 제안은
                특정 정보를 지운 뒤 <a href="/findings-recommendations">지적권고사례</a>에 직접 옮겨 적으세요. 본문은
                외부 AI 에 넘기지 않습니다.
            </p>
        </div>

        <div class="toolbar">
            <div class="tabs">
                <button class="tab active" data-status="open">진행 중 (<span id="cntOpen">0</span>)</button>
                <button class="tab" data-status="answered">답변 완료 (<span id="cntAnswered">0</span>)</button>
                <button class="tab" data-status="closed">종결 (<span id="cntClosed">0</span>)</button>
            </div>
            <span class="muted" id="stats"></span>
            <button id="refreshBtn" class="btn-secondary">🔄 새로고침</button>
        </div>

        <div id="list" class="list"><p class="muted">불러오는 중...</p></div>
    </div>

    <style>
        .padmin {
            max-width: 1000px;
            margin: 0 auto;
        }
        .page-title {
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin: 0.5rem 0 1rem;
        }
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }
        .tabs {
            display: flex;
            gap: 0.4rem;
        }
        .tab {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 0.4rem 0.8rem;
            border-radius: 99px;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .tab.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .btn-secondary {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: inherit;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            cursor: pointer;
        }
        .list {
            display: grid;
            gap: 0.75rem;
        }
        .card {
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-card);
            padding: 0.9rem 1rem;
        }
        .card.anonymous {
            border-left-color: #a855f7;
        }
        .card.signed {
            border-left-color: var(--accent);
        }
        .meta {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-bottom: 0.3rem;
        }
        .badge {
            border: 1px solid currentColor;
            border-radius: 999px;
            padding: 0.05rem 0.45rem;
        }
        .badge.anonymous {
            color: #a855f7;
        }
        .badge.signed {
            color: var(--accent);
        }
        .body {
            white-space: pre-wrap;
            font-size: 0.9rem;
            line-height: 1.55;
        }
        .attachments {
            margin-top: 0.4rem;
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            font-size: 0.8rem;
        }
        .attachments button {
            background: none;
            border: 1px solid var(--border-color);
            color: var(--accent);
            border-radius: 6px;
            padding: 0.15rem 0.5rem;
            cursor: pointer;
        }
        .form {
            display: grid;
            gap: 0.5rem;
            margin-top: 0.6rem;
        }
        .form label {
            font-size: 0.8rem;
            color: var(--text-muted);
            display: grid;
            gap: 0.2rem;
        }
        .form textarea,
        .form select {
            width: 100%;
            background: var(--bg-primary, transparent);
            color: inherit;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 0.45rem;
            font: inherit;
        }
        .form textarea {
            min-height: 3em;
            resize: vertical;
        }
        .actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }
        .btn {
            border: none;
            border-radius: 6px;
            padding: 0.45rem 0.9rem;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .btn-save {
            background: var(--accent);
            color: #fff;
        }
        .btn-del {
            background: none;
            border: 1px solid #ef4444;
            color: #ef4444;
        }
        .muted {
            color: var(--text-muted);
            font-size: 0.85rem;
        }
    </style>
</DashboardLayout>

<script>
    import { userProfile } from '../../store/user';
    import { supabase } from '../../lib/supabase-browser';
    import { actions } from 'astro:actions';

    type Att = { storage_path: string; size: number; kind: 'image' | 'pdf' };
    type Proposal = {
        id: string;
        category: string;
        body: string;
        attachments: Att[] | null;
        status: 'new' | 'reviewing' | 'answered' | 'closed';
        admin_note: string | null;
        admin_reply: string | null;
        mode: 'anonymous' | 'signed';
        author_id: string | null;
        created_at: string | null;
        created_day: string;
        answered_at: string | null;
    };
    const STATUS_LABEL: Record<string, string> = {
        new: '접수됨',
        reviewing: '검토 중',
        answered: '답변 완료',
        closed: '종결',
    };

    function esc(s: string | null | undefined): string {
        return (s ?? '').replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
        );
    }

    document.addEventListener('astro:page-load', () => {
        const currentUser = userProfile.get() as any;
        if (!currentUser?.id) return;
        if (currentUser.is_admin !== 'true') {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/mypage';
            return;
        }
        const listEl = document.getElementById('list')!;
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
        let tab: 'open' | 'answered' | 'closed' = 'open';
        let all: Proposal[] = [];
        let usernames = new Map<string, string>();

        tabs.forEach((t) =>
            t.addEventListener('click', () => {
                tabs.forEach((x) => x.classList.toggle('active', x === t));
                tab = t.dataset.status as typeof tab;
                render();
            }),
        );
        document.getElementById('refreshBtn')?.addEventListener('click', load);
        load();

        async function load() {
            listEl.innerHTML = '<p class="muted">불러오는 중...</p>';
            const { data, error } = await supabase
                .from('proposals')
                .select(
                    'id, category, body, attachments, status, admin_note, admin_reply, mode, author_id, created_at, created_day, answered_at',
                )
                .order('created_day', { ascending: false })
                .limit(500);
            if (error) {
                listEl.innerHTML = `<p style="color:red">로드 실패: ${esc(error.message)}</p>`;
                return;
            }
            all = (data ?? []) as Proposal[];
            // signed 작성자 아이디만(익명은 author_id 자체가 없다)
            const ids = Array.from(new Set(all.map((p) => p.author_id).filter((x): x is string => Boolean(x))));
            usernames = new Map();
            if (ids.length) {
                const { data: profiles } = await supabase.from('profiles').select('id, username').in('id', ids);
                (profiles ?? []).forEach((p: any) => usernames.set(p.id, p.username ?? '(아이디 없음)'));
            }
            const open = all.filter((p) => p.status === 'new' || p.status === 'reviewing').length;
            const answered = all.filter((p) => p.status === 'answered').length;
            const closed = all.filter((p) => p.status === 'closed').length;
            document.getElementById('cntOpen')!.textContent = String(open);
            document.getElementById('cntAnswered')!.textContent = String(answered);
            document.getElementById('cntClosed')!.textContent = String(closed);
            const anon = all.filter((p) => p.mode === 'anonymous').length;
            document.getElementById('stats')!.textContent =
                `전체 ${all.length}건 · 익명 ${anon}건 · 아이디 ${all.length - anon}건`;
            render();
        }

        function render() {
            const rows = all.filter((p) =>
                tab === 'open' ? p.status === 'new' || p.status === 'reviewing' : p.status === tab,
            );
            if (!rows.length) {
                listEl.innerHTML = '<p class="muted">해당 항목이 없습니다.</p>';
                return;
            }
            listEl.innerHTML = rows
                .map((p) => {
                    // signed 인데 author_id 가 비어 있으면 탈퇴한 회원(ON DELETE SET NULL) — 익명과 구별해 표기한다.
                    const signedName = p.author_id ? usernames.get(p.author_id) : undefined;
                    const who =
                        p.mode === 'signed'
                            ? signedName
                                ? `@${esc(signedName)}`
                                : '(탈퇴한 회원)'
                            : '작성자 기록 없음';
                    const when =
                        p.mode === 'signed' && p.created_at
                            ? esc(String(p.created_at).replace('T', ' ').slice(0, 16))
                            : esc(p.created_day);
                    const atts = (p.attachments ?? [])
                        .map(
                            (a, i) =>
                                `<button type="button" data-att="${esc(a.storage_path)}">첨부 ${i + 1} (${a.kind === 'pdf' ? 'PDF' : '이미지'} · ${(a.size / 1024).toFixed(0)}KB)</button>`,
                        )
                        .join('');
                    return `<div class="card ${p.mode}" data-id="${p.id}">
                        <div class="meta">
                            <span class="badge ${p.mode}">${p.mode === 'anonymous' ? '익명' : '아이디'}</span>
                            <span>[${esc(p.category)}]</span><span>${when}</span><span>${who}</span>
                            <span>${STATUS_LABEL[p.status]}</span>
                        </div>
                        <div class="body">${esc(p.body)}</div>
                        ${atts ? `<div class="attachments">${atts}</div>` : ''}
                        <div class="form">
                            <label>상태<select data-f="status">${(['new', 'reviewing', 'answered', 'closed'] as const)
                                .map(
                                    (s) =>
                                        `<option value="${s}" ${p.status === s ? 'selected' : ''}>${STATUS_LABEL[s]}</option>`,
                                )
                                .join('')}</select></label>
                            <label>관리자 메모(내부)<textarea data-f="note">${esc(p.admin_note)}</textarea></label>
                            <label>답변(제안자에게 보임)<textarea data-f="reply">${esc(p.admin_reply)}</textarea></label>
                        </div>
                        <div class="actions">
                            <button class="btn btn-save" data-act="save">저장</button>
                            <button class="btn btn-del" data-act="delete">삭제</button>
                        </div>
                    </div>`;
                })
                .join('');

            listEl.querySelectorAll<HTMLButtonElement>('[data-att]').forEach((btn) =>
                btn.addEventListener('click', async () => {
                    const id = btn.closest<HTMLElement>('.card')!.dataset.id!;
                    const { data, error } = await actions.proposalAttachmentUrl({ id, storagePath: btn.dataset.att! });
                    if (error || !data) {
                        alert(`첨부를 열 수 없습니다: ${error?.message ?? ''}`);
                        return;
                    }
                    window.open(data.url, '_blank', 'noopener');
                }),
            );
            listEl.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) =>
                btn.addEventListener('click', async () => {
                    const card = btn.closest<HTMLElement>('.card')!;
                    const id = card.dataset.id!;
                    if (btn.dataset.act === 'delete') {
                        if (!confirm('이 제안과 첨부를 삭제할까요? 되돌릴 수 없습니다.')) return;
                        btn.disabled = true;
                        const { error } = await actions.deleteProposal({ id });
                        if (error) {
                            alert(`삭제 실패: ${error.message}`);
                            btn.disabled = false;
                            return;
                        }
                        await load();
                        return;
                    }
                    const status = card.querySelector<HTMLSelectElement>('[data-f="status"]')!
                        .value as Proposal['status'];
                    const adminNote = card.querySelector<HTMLTextAreaElement>('[data-f="note"]')!.value.trim();
                    const adminReply = card.querySelector<HTMLTextAreaElement>('[data-f="reply"]')!.value.trim();
                    if (
                        status === 'answered' &&
                        !adminReply &&
                        !confirm('답변 내용이 비어 있습니다. 그래도 답변 완료로 저장할까요?')
                    )
                        return;
                    btn.disabled = true;
                    const { error } = await actions.reviewProposal({ id, status, adminNote, adminReply });
                    btn.disabled = false;
                    if (error) {
                        alert(`저장 실패: ${error.message}`);
                        return;
                    }
                    await load();
                }),
            );
        }
    });
</script>
