---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';

// 회원 목록(관리자). 명세: .spec/src/pages/admin/members.md
// 2단계 2-2(2026-09-19): 옛 "회원명부 등록"(엑셀 → allowed_members)을 대체. 명부는 앱이 갖지 않는다.
export const prerender = false;
---

<DashboardLayout title="회원 목록">
    <div class="members-container">
        <div class="header">
            <div class="page-title"><Icon name="clipboard" size="24" /> 회원 목록</div>
            <p class="subtitle">
                아이디·소속기관·소속학회·회원 상태만 봅니다(실명·이메일은 앱이 보관하지 않습니다). 가입 승인·거절과 기관
                등록 요청 처리는 <a href="/admin/member-approval">가입 승인</a>에서 합니다.
            </p>
        </div>

        <div class="toolbar">
            <input type="search" id="memberSearch" placeholder="아이디 검색" autocomplete="off" />
            <select id="statusFilter">
                <option value="">전체 상태</option>
                <option value="active">정상</option>
                <option value="pending">승인 대기</option>
                <option value="suspended">정지</option>
                <option value="banned">탈퇴처리</option>
            </select>
            <span id="memberCount" class="count">0명</span>
            <button id="refreshBtn" class="btn-secondary">🔄 새로고침</button>
        </div>

        <div class="table-wrapper">
            <table id="membersTable">
                <thead>
                    <th>아이디</th>
                    <th>로그인</th>
                    <th>소속기관</th>
                    <th>소속학회</th>
                    <th>상태</th>
                    <th>가입일</th>
                </thead>
                <tbody>
                    <tr><td colspan="6" style="text-align:center;">데이터를 불러오는 중...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>

<script>
    import { userProfile } from '../../store/user';
    import { supabase } from '../../lib/supabase-browser';
    import { HOSPITALS, type Hospital } from '../../data/hospitals';

    const SOCIETY_MAP: Record<string, string> = {
        nuclear_medicine: '대한핵의학회',
        technology: '대한핵의학기술학회',
        none: '비소속',
    };
    const STATUS_MAP: Record<string, string> = {
        pending: '승인 대기',
        active: '정상',
        suspended: '정지',
        banned: '탈퇴처리',
    };

    function escapeHtml(s: string): string {
        return s.replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
        );
    }

    let allHospitals: Hospital[] = [...HOSPITALS];

    function hospitalCell(row: { hospital_id: string | null; hospital_request: string | null }): string {
        const base = row.hospital_id
            ? allHospitals.find((h) => h.id === row.hospital_id)?.name || row.hospital_id
            : '-';
        return row.hospital_request
            ? `${escapeHtml(base)} <span class="badge-request">🆕 요청: ${escapeHtml(row.hospital_request)}</span>`
            : escapeHtml(base);
    }

    document.addEventListener('astro:page-load', () => {
        const currentUser = userProfile.get() as any;
        if (!currentUser?.id) return;
        if (currentUser.is_admin !== 'true') {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/mypage';
            return;
        }

        const tbody = document.querySelector('#membersTable tbody');
        const countEl = document.getElementById('memberCount');
        const searchInput = document.getElementById('memberSearch') as HTMLInputElement | null;
        const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement | null;
        const refreshBtn = document.getElementById('refreshBtn') as HTMLButtonElement | null;
        if (!tbody) return;

        let rows: any[] = [];

        async function load() {
            tbody!.innerHTML = '<tr><td colspan="6" style="text-align:center;">로딩 중...</td></tr>';
            try {
                const { data: custom } = await supabase.from('hospitals_custom').select('id, name');
                allHospitals = [...HOSPITALS, ...((custom as Hospital[] | null) ?? [])];
            } catch {
                allHospitals = [...HOSPITALS];
            }
            const { data, error } = await supabase
                .from('profiles')
                .select('id, username, provider, status, society, hospital_id, hospital_request, is_admin, created_at')
                .order('created_at', { ascending: false });
            if (error) {
                tbody!.innerHTML = `<tr><td colspan="6" style="text-align:center; color:red;">로드 실패: ${escapeHtml(error.message)}</td></tr>`;
                return;
            }
            rows = data || [];
            render();
        }

        function render() {
            const keyword = (searchInput?.value || '').trim().toLowerCase();
            const status = statusFilter?.value || '';
            const filtered = rows.filter(
                (r) =>
                    (!keyword || (r.username || '').toLowerCase().includes(keyword)) &&
                    (!status || r.status === status),
            );
            if (countEl) countEl.textContent = `${filtered.length}명`;
            if (filtered.length === 0) {
                tbody!.innerHTML = '<tr><td colspan="6" style="text-align:center;">표시할 회원이 없습니다.</td></tr>';
                return;
            }
            tbody!.innerHTML = filtered
                .map(
                    (r) => `
                <tr>
                    <td>@${escapeHtml(r.username || '(미설정)')}${r.is_admin ? ' <span class="badge-admin">ADMIN</span>' : ''}</td>
                    <td>${r.provider === 'kakao' ? '카카오' : '아이디'}</td>
                    <td>${hospitalCell(r)}</td>
                    <td>${SOCIETY_MAP[r.society] || '-'}</td>
                    <td>${STATUS_MAP[r.status] || escapeHtml(r.status || '-')}</td>
                    <td>${r.created_at ? new Date(r.created_at).toLocaleDateString('ko-KR') : '-'}</td>
                </tr>`,
                )
                .join('');
        }

        searchInput?.addEventListener('input', render);
        statusFilter?.addEventListener('change', render);
        refreshBtn?.addEventListener('click', load);
        load();
    });
</script>

<style>
    .members-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 0;
    }
    .header {
        margin-bottom: 1.5rem;
    }
    .page-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .subtitle {
        color: var(--text-muted);
        line-height: 1.5;
    }
    .toolbar {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .toolbar input,
    .toolbar select {
        padding: 0.4rem 0.6rem;
        font-size: 0.9rem;
    }
    .count {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-left: auto;
    }
    .btn-secondary {
        background: transparent;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        padding: 0.4rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .table-wrapper {
        max-height: 70vh;
        overflow: auto;
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    th,
    td {
        padding: 0.6rem 0.9rem;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
        white-space: nowrap;
    }
    th {
        background: rgba(255, 255, 255, 0.05);
        position: sticky;
        top: 0;
        color: var(--text-muted);
    }
    :global(.badge-request) {
        display: inline-block;
        margin-left: 0.4rem;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.18);
        color: #f59e0b;
        font-size: 0.75rem;
        font-weight: 600;
    }
    :global(.badge-admin) {
        display: inline-block;
        margin-left: 0.3rem;
        padding: 0.05rem 0.4rem;
        border-radius: 999px;
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
    }
</style>
