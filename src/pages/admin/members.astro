---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';

// 회원 목록(관리자). 명세: .spec/src/pages/admin/members.md
// 2단계 2-2(2026-09-19): 옛 "회원명부 등록"(엑셀 → allowed_members)을 대체. 명부는 앱이 갖지 않는다.
export const prerender = false;
---

<DashboardLayout title="회원 목록">
    <div class="members-container">
        <div class="header">
            <div class="page-title"><Icon name="clipboard" size="24" /> 회원 목록</div>
            <p class="subtitle">
                아이디·소속기관·소속학회·회원 상태만 봅니다(실명·이메일은 앱이 보관하지 않습니다). 가입 승인·거절과 기관
                등록 요청 처리는 <a href="/admin/member-approval">가입 승인</a>에서 합니다.
            </p>
        </div>

        <div class="toolbar">
            <input type="search" id="memberSearch" placeholder="아이디 검색" autocomplete="off" />
            <select id="statusFilter">
                <option value="">전체 상태</option>
                <option value="active">정상</option>
                <option value="pending">승인 대기</option>
                <option value="suspended">정지</option>
                <option value="banned">탈퇴처리</option>
            </select>
            <span id="memberCount" class="count">0명</span>
            <button id="refreshBtn" class="btn-secondary">🔄 새로고침</button>
        </div>

        <div class="table-wrapper">
            <table id="membersTable">
                <thead>
                    <th>아이디</th>
                    <th>로그인</th>
                    <th>소속기관</th>
                    <th>소속학회</th>
                    <th>상태</th>
                    <th>관리자</th>
                    <th>게시 권한</th>
                    <th>가입일</th>
                </thead>
                <tbody>
                    <tr><td colspan="8" style="text-align:center;">데이터를 불러오는 중...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>

<script>
    import { userProfile } from '../../store/user';
    import { supabase } from '../../lib/supabase-browser';
    import { HOSPITALS, type Hospital } from '../../data/hospitals';

    const SOCIETY_MAP: Record<string, string> = {
        nuclear_medicine: '대한핵의학회',
        technology: '대한핵의학기술학회',
        none: '비소속',
    };
    const STATUS_MAP: Record<string, string> = {
        pending: '승인 대기',
        active: '정상',
        suspended: '정지',
        banned: '탈퇴처리',
    };

    function escapeHtml(s: string): string {
        return s.replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
        );
    }

    let allHospitals: Hospital[] = [...HOSPITALS];

    function hospitalCell(row: { hospital_id: string | null; hospital_request: string | null }): string {
        const base = row.hospital_id
            ? allHospitals.find((h) => h.id === row.hospital_id)?.name || row.hospital_id
            : '-';
        return row.hospital_request
            ? `${escapeHtml(base)} <span class="badge-request">🆕 요청: ${escapeHtml(row.hospital_request)}</span>`
            : escapeHtml(base);
    }

    document.addEventListener('astro:page-load', () => {
        const currentUser = userProfile.get() as any;
        if (!currentUser?.id) return;
        if (currentUser.is_admin !== 'true') {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/mypage';
            return;
        }

        const tbody = document.querySelector('#membersTable tbody');
        const countEl = document.getElementById('memberCount');
        const searchInput = document.getElementById('memberSearch') as HTMLInputElement | null;
        const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement | null;
        const refreshBtn = document.getElementById('refreshBtn') as HTMLButtonElement | null;
        if (!tbody) return;

        let rows: any[] = [];

        async function load() {
            tbody!.innerHTML = '<tr><td colspan="8" style="text-align:center;">로딩 중...</td></tr>';
            try {
                const { data: custom } = await supabase.from('hospitals_custom').select('id, name');
                allHospitals = [...HOSPITALS, ...((custom as Hospital[] | null) ?? [])];
            } catch {
                allHospitals = [...HOSPITALS];
            }
            const { data, error } = await supabase
                .from('profiles')
                .select(
                    'id, username, provider, status, society, hospital_id, hospital_request, is_admin, can_publish, reject_count, created_at',
                )
                .order('created_at', { ascending: false });
            if (error) {
                tbody!.innerHTML = `<tr><td colspan="8" style="text-align:center; color:red;">로드 실패: ${escapeHtml(error.message)}</td></tr>`;
                return;
            }
            rows = data || [];
            render();
        }

        function render() {
            const keyword = (searchInput?.value || '').trim().toLowerCase();
            const status = statusFilter?.value || '';
            const filtered = rows.filter(
                (r) =>
                    (!keyword || (r.username || '').toLowerCase().includes(keyword)) &&
                    (!status || r.status === status),
            );
            if (countEl) countEl.textContent = `${filtered.length}명`;
            if (filtered.length === 0) {
                tbody!.innerHTML = '<tr><td colspan="8" style="text-align:center;">표시할 회원이 없습니다.</td></tr>';
                return;
            }
            tbody!.innerHTML = filtered
                .map(
                    (r) => `
                <tr>
                    <td>@${escapeHtml(r.username || '(미설정)')}</td>
                    <td>${r.provider === 'kakao' ? '카카오' : '아이디'}</td>
                    <td>${hospitalCell(r)}</td>
                    <td>${SOCIETY_MAP[r.society] || '-'}</td>
                    <td>${STATUS_MAP[r.status] || escapeHtml(r.status || '-')}</td>
                    <td>${adminCell(r)}</td>
                    <td>${publishCell(r)}</td>
                    <td>${r.created_at ? new Date(r.created_at).toLocaleDateString('ko-KR') : '-'}</td>
                </tr>`,
                )
                .join('');

            tbody!.querySelectorAll('.btn-admin-toggle').forEach((btn) => {
                btn.addEventListener('click', () =>
                    toggleAdmin((btn as HTMLElement).dataset.id!, (btn as HTMLElement).dataset.next === 'true'),
                );
            });

            tbody!.querySelectorAll('.btn-publish-toggle').forEach((btn) => {
                btn.addEventListener('click', () =>
                    togglePublish((btn as HTMLElement).dataset.id!, (btn as HTMLElement).dataset.next === 'true'),
                );
            });
        }

        // 관리자 지정/해제(2026-09-20). 본인 행에는 버튼을 두지 않는다(서버도 자기 해제를 막는다) —
        // 실수로 자기 권한을 날리면 화면으로는 되돌릴 수 없기 때문. 비활성 계정은 부여 대상이 아니다.
        function adminCell(r: any): string {
            const badge = r.is_admin ? '<span class="badge-admin">ADMIN</span>' : '—';
            if (r.id === currentUser.id) return `${badge} <span class="self-note">(본인)</span>`;
            const inactive = r.status === 'banned' || r.status === 'pending';
            if (inactive && !r.is_admin) return badge;
            return `${badge} <button class="btn-mini btn-admin-toggle" data-id="${r.id}" data-next="${r.is_admin ? 'false' : 'true'}">${r.is_admin ? '해제' : '지정'}</button>`;
        }

        // 2-1 업로드 권한: 직접 게시 가능 / 첫 제출 검토 대기 / 제출 차단(반려 3회). 관리자는 부여·회수.
        function publishCell(r: any): string {
            const rejected = Number(r.reject_count || 0);
            const label = r.is_admin
                ? '관리자'
                : rejected >= 3
                  ? `제출 차단(반려 ${rejected}회)`
                  : r.can_publish
                    ? '직접 게시 가능'
                    : '첫 제출 검토 대기';
            const rejectNote =
                !r.is_admin && rejected > 0 && rejected < 3
                    ? ` <span class="badge-request">반려 ${rejected}회</span>`
                    : '';
            // 관리자 행·가입 거절(banned)/대기(pending) 행에는 버튼 없음 — 로그인 못 하는 계정에 권한을 만지는 건 무의미하고,
            // 이름이 비슷한 행(test0919 vs test09191)을 잘못 누르는 실수를 부른다(2026-09-20 실사례).
            const inactive = r.status === 'banned' || r.status === 'pending';
            const toggle =
                r.is_admin || inactive
                    ? ''
                    : ` <button class="btn-mini btn-publish-toggle" data-id="${r.id}" data-next="${r.can_publish ? 'false' : 'true'}">${r.can_publish ? '회수' : '부여'}</button>`;
            return `${label}${rejectNote}${toggle}`;
        }

        async function toggleAdmin(targetUserId: string, next: boolean) {
            const message = next
                ? '이 회원에게 관리자 권한을 부여합니다.\n\n가입 승인·제출 검토·사건 게시·제안 답변·알림 발송을 모두 할 수 있게 됩니다. 계속할까요?'
                : '이 회원의 관리자 권한을 해제합니다. 계속할까요?';
            if (!confirm(message)) return;
            const { actions } = await import('astro:actions');
            const { data, error } = await actions.setAdminRole({ targetUserId, isAdmin: next });
            if (error || !data?.success) {
                alert(`처리 실패: ${error?.message ?? '알 수 없는 오류'}`);
                return;
            }
            await load();
        }

        async function togglePublish(targetUserId: string, next: boolean) {
            if (
                !confirm(
                    next
                        ? '이 회원에게 직접 게시 권한을 부여할까요? 알림이 갑니다.'
                        : '이 회원의 직접 게시 권한을 회수할까요? 다음 제출부터 검토 대기가 됩니다. 알림이 갑니다.',
                )
            )
                return;
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.setPublishPermission({
                    adminId: currentUser.id,
                    targetUserId,
                    canPublish: next,
                });
                if (result.error) throw new Error(result.error.message);
                load();
            } catch (err) {
                alert('❌ 처리 중 오류: ' + (err as Error).message);
            }
        }

        searchInput?.addEventListener('input', render);
        statusFilter?.addEventListener('change', render);
        refreshBtn?.addEventListener('click', load);
        load();
    });
</script>

<style>
    .members-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 0;
    }
    .header {
        margin-bottom: 1.5rem;
    }
    .page-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .subtitle {
        color: var(--text-muted);
        line-height: 1.5;
    }
    .toolbar {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .toolbar input,
    .toolbar select {
        padding: 0.4rem 0.6rem;
        font-size: 0.9rem;
    }
    .count {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-left: auto;
    }
    .btn-secondary {
        background: transparent;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        padding: 0.4rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .table-wrapper {
        max-height: 70vh;
        overflow: auto;
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    th,
    td {
        padding: 0.6rem 0.9rem;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
        white-space: nowrap;
    }
    th {
        background: rgba(255, 255, 255, 0.05);
        position: sticky;
        top: 0;
        color: var(--text-muted);
    }
    :global(.badge-request) {
        display: inline-block;
        margin-left: 0.4rem;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.18);
        color: #f59e0b;
        font-size: 0.75rem;
        font-weight: 600;
    }
    :global(.btn-mini) {
        margin-left: 0.4rem;
        padding: 0.15rem 0.5rem;
        font-size: 0.75rem;
        border: 1px solid var(--border-color);
        background: transparent;
        color: var(--text-main);
        border-radius: 6px;
        cursor: pointer;
    }
    :global(.self-note) {
        color: var(--text-muted);
        font-size: 0.75rem;
    }
    :global(.badge-admin) {
        display: inline-block;
        margin-left: 0.3rem;
        padding: 0.05rem 0.4rem;
        border-radius: 999px;
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
    }
</style>
