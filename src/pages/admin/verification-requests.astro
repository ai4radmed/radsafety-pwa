---
/**
 * src/pages/admin/verification-requests.astro
 * 리팩토링된 인증관리 페이지
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import VerificationTabs from '../../components/admin/verification/VerificationTabs.astro';
import VerificationTable from '../../components/admin/verification/VerificationTable.astro';
import VerificationDetailModal from '../../components/admin/verification/VerificationDetailModal.astro';

export const prerender = false;
---

<DashboardLayout title="인증관리">
    <div class="requests-container">
        <div class="page-header">
            <h1 class="page-title">인증관리</h1>
            <p class="page-subtitle">회원들의 인증 상태를 확인하고 권한을 관리합니다.</p>
        </div>

        <VerificationTabs />
        <VerificationTable />
        <VerificationDetailModal />
    </div>
</DashboardLayout>

<style>
    .requests-container {
        max-width: 1400px;
        margin: 0 auto;
    }
    .page-header {
        margin-bottom: 2rem;
    }
    .page-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.5rem;
    }
    .page-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
    }
</style>

<script>
    import { userProfile } from '../../store/user';
    import { VerificationController } from '../../lib/admin/verification-controller';

    function init() {
        const currentUser = userProfile.get() as any;

        const isAdmin = currentUser.is_admin === 'true';
        const isBypass = new URLSearchParams(window.location.search).get('bypass_admin') === 'true';

        if (!isAdmin && !isBypass) {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/mypage';
            return;
        }

        new VerificationController(currentUser);
    }

    document.addEventListener('astro:page-load', init);
    // document.addEventListener('DOMContentLoaded', init); // Fallback
</script>
