---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';

export const prerender = false;
---

<DashboardLayout title="가입 승인">
    <div class="approval-container">
        <div class="header">
            <div class="page-title"><Icon name="user" size="24" /> 가입 승인</div>
            <p class="subtitle">
                새로 가입한 회원(대기 상태)을 검토하여 승인하거나 거절합니다. 승인 전까지는 지적사례 상세·자료실 업로드
                등 회원 전용 기능을 쓸 수 없습니다.
            </p>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h2 style="margin:0; font-size:1rem;">대기 중인 가입 신청 (<span id="pendingCount">0</span>명)</h2>
            <button id="refreshBtn" class="btn-secondary">🔄 새로고침</button>
        </div>

        <div class="table-wrapper">
            <table id="pendingTable">
                <thead>
                    <th>아이디</th>
                    <th>로그인 방식</th>
                    <th>소속학회</th>
                    <th>소속기관</th>
                    <th>가입일</th>
                    <th>처리</th>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6" style="text-align:center;">데이터를 불러오는 중...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="section-head">
            <h2 style="margin:0; font-size:1rem;">기관 등록 요청 (<span id="requestCount">0</span>건)</h2>
            <p class="section-hint">
                목록에 없는 기관을 적은 가입자는 소속이 <strong>기타</strong>로 들어옵니다. 요청 기관명을 확인(필요하면
                고쳐서) <strong>등록</strong>하면 그 자리에서 회원기관에 추가되고 가입자 소속이 바뀝니다(배포 불필요).
                표기만 다른 기존 기관이면 드롭다운에서 골라 <strong>합치기</strong>, 부적절하면 <strong>거절</strong
                >(소속은 기타 유지). 어느 경우든 가입자에게 알림이 갑니다.
            </p>
        </div>

        <div class="table-wrapper">
            <table id="requestTable">
                <thead>
                    <th>아이디</th>
                    <th>회원 상태</th>
                    <th>가입일</th>
                    <th>처리</th>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4" style="text-align:center;">데이터를 불러오는 중...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>

<script>
    import { userProfile } from '../../store/user';
    import { supabase } from '../../lib/supabase-browser';
    import { HOSPITALS, type Hospital } from '../../data/hospitals';

    const SOCIETY_MAP: Record<string, string> = {
        nuclear_medicine: '대한핵의학회',
        technology: '대한핵의학기술학회',
        none: '없음',
    };

    const STATUS_MAP: Record<string, string> = {
        pending: '승인 대기',
        active: '정상',
        suspended: '정지',
        banned: '탈퇴처리',
    };

    function escapeHtml(s: string): string {
        return s.replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
        );
    }

    // 정적 목록 + 관리자가 등록한 hospitals_custom — 표시·합치기 후보 모두 이 합집합을 본다.
    let allHospitals: Hospital[] = [...HOSPITALS];

    async function loadCustomHospitals() {
        try {
            const { data } = await supabase.from('hospitals_custom').select('id, name, retired');
            allHospitals = [...HOSPITALS, ...((data as Hospital[] | null) ?? [])];
        } catch {
            allHospitals = [...HOSPITALS];
        }
    }

    function hospitalName(hospitalId: string | null): string {
        if (!hospitalId) return '-';
        return allHospitals.find((h) => h.id === hospitalId)?.name || hospitalId;
    }

    // 요청이 걸린 행은 소속기관 칸에 요청 기관명을 같이 보여준다.
    function hospitalCell(row: { hospital_id: string | null; hospital_request: string | null }): string {
        const base = hospitalName(row.hospital_id);
        if (!row.hospital_request) return base;
        return `${base} <span class="badge-request">🆕 요청: ${escapeHtml(row.hospital_request)}</span>`;
    }

    function selectableHospitals(): Hospital[] {
        return allHospitals.filter((h) => !h.retired && h.id !== 'other');
    }

    document.addEventListener('astro:page-load', () => {
        const currentUser = userProfile.get() as any;

        // Guard: Admin only (비로그인은 DashboardLayout이 /login으로 리다이렉트)
        if (!currentUser?.id) return;
        if (currentUser.is_admin !== 'true') {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/mypage';
            return;
        }

        const tbody = document.querySelector('#pendingTable tbody');
        const countSpan = document.getElementById('pendingCount');
        const requestBody = document.querySelector('#requestTable tbody');
        const requestCountSpan = document.getElementById('requestCount');
        const refreshBtn = document.getElementById('refreshBtn') as HTMLButtonElement | null;

        if (!tbody || !requestBody) return;

        refreshBtn?.addEventListener('click', loadAll);
        loadAll();

        async function loadAll() {
            await loadCustomHospitals();
            loadPending();
            loadRequests();
        }

        async function loadPending() {
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">로딩 중...</td></tr>';

            const { data, error } = await supabase
                .from('profiles')
                .select('id, username, provider, society, hospital_id, hospital_request, created_at')
                .eq('status', 'pending')
                .order('created_at', { ascending: true });

            if (error) {
                console.error(error);
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:red;">로드 실패: ${error.message}</td></tr>`;
                return;
            }

            renderTable(data || []);
        }

        function renderTable(rows: any[]) {
            if (!tbody || !countSpan) return;

            countSpan.textContent = String(rows.length);

            if (rows.length === 0) {
                tbody.innerHTML =
                    '<tr><td colspan="6" style="text-align:center;">대기 중인 가입 신청이 없습니다.</td></tr>';
                return;
            }

            tbody.innerHTML = '';
            rows.forEach((row) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>@${row.username || '(미설정)'}</td>
                    <td>${row.provider === 'kakao' ? '카카오' : '아이디'}</td>
                    <td>${SOCIETY_MAP[row.society] || row.society || '-'}</td>
                    <td>${hospitalCell(row)}</td>
                    <td>${row.created_at ? new Date(row.created_at).toLocaleDateString('ko-KR') : '-'}</td>
                    <td class="actions-cell">
                        <button class="btn-approve" data-id="${row.id}">승인</button>
                        <button class="btn-reject" data-id="${row.id}">거절</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            tbody.querySelectorAll('.btn-approve').forEach((btn) => {
                btn.addEventListener('click', () => approve((btn as HTMLElement).dataset.id!));
            });
            tbody.querySelectorAll('.btn-reject').forEach((btn) => {
                btn.addEventListener('click', () => reject((btn as HTMLElement).dataset.id!));
            });
        }

        // 기관 등록 요청은 회원 상태와 무관하게 hospital_request 가 남아 있는 전부 —
        // 가입 승인이 먼저 끝나 위 표에서 사라져도 요청은 여기 남는다.
        async function loadRequests() {
            if (!requestBody) return;
            requestBody.innerHTML = '<tr><td colspan="4" style="text-align:center;">로딩 중...</td></tr>';

            const { data, error } = await supabase
                .from('profiles')
                .select('id, username, hospital_id, hospital_request, status, created_at')
                .not('hospital_request', 'is', null)
                .order('created_at', { ascending: true });

            if (error) {
                console.error(error);
                requestBody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:red;">로드 실패: ${error.message}</td></tr>`;
                return;
            }

            renderRequests(data || []);
        }

        function renderRequests(rows: any[]) {
            if (!requestBody || !requestCountSpan) return;

            requestCountSpan.textContent = String(rows.length);

            if (rows.length === 0) {
                requestBody.innerHTML =
                    '<tr><td colspan="4" style="text-align:center;">처리할 기관 등록 요청이 없습니다.</td></tr>';
                return;
            }

            const options = selectableHospitals()
                .map((h) => `<option value="${h.id}">${escapeHtml(h.name)}</option>`)
                .join('');

            requestBody.innerHTML = '';
            rows.forEach((row) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>@${row.username || '(미설정)'}</td>
                    <td>${STATUS_MAP[row.status] || row.status || '-'}</td>
                    <td>${row.created_at ? new Date(row.created_at).toLocaleDateString('ko-KR') : '-'}</td>
                    <td class="actions-cell request-actions">
                        <div class="request-line">
                            <input class="request-name" data-id="${row.id}" maxlength="60" value="${escapeHtml(row.hospital_request)}" />
                            <button class="btn-approve btn-register" data-id="${row.id}">이 이름으로 등록</button>
                        </div>
                        <div class="request-line">
                            <select class="request-select" data-id="${row.id}">
                                <option value="">기존 기관으로 합치기…</option>
                                ${options}
                            </select>
                            <button class="btn-secondary btn-merge" data-id="${row.id}">합치기</button>
                            <button class="btn-reject btn-decline" data-id="${row.id}">거절</button>
                        </div>
                    </td>
                `;
                requestBody.appendChild(tr);
            });

            requestBody.querySelectorAll('.btn-register').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const id = (btn as HTMLElement).dataset.id!;
                    const input = requestBody!.querySelector(`.request-name[data-id="${id}"]`) as HTMLInputElement;
                    registerRequest(id, input?.value.trim() || '');
                });
            });
            requestBody.querySelectorAll('.btn-merge').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const id = (btn as HTMLElement).dataset.id!;
                    const select = requestBody!.querySelector(`.request-select[data-id="${id}"]`) as HTMLSelectElement;
                    mergeRequest(id, select?.value || '');
                });
            });
            requestBody.querySelectorAll('.btn-decline').forEach((btn) => {
                btn.addEventListener('click', () => declineRequest((btn as HTMLElement).dataset.id!));
            });
        }

        async function approve(targetUserId: string) {
            if (!confirm('이 회원의 가입을 승인하시겠습니까?')) return;
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.approvePendingMember({
                    adminId: currentUser.id,
                    targetUserId,
                });
                if (result.error) throw new Error(result.error.message);
                loadAll();
            } catch (err) {
                alert('❌ 승인 처리 중 오류: ' + (err as Error).message);
            }
        }

        async function reject(targetUserId: string) {
            if (!confirm('이 가입 신청을 거절하시겠습니까? 재가입하려면 새 아이디로 다시 가입해야 합니다.')) return;
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.rejectPendingMember({
                    adminId: currentUser.id,
                    targetUserId,
                });
                if (result.error) throw new Error(result.error.message);
                loadAll();
            } catch (err) {
                alert('❌ 거절 처리 중 오류: ' + (err as Error).message);
            }
        }

        async function registerRequest(targetUserId: string, name: string) {
            if (name.length < 2) {
                alert('기관명을 2자 이상 입력하세요.');
                return;
            }
            if (
                !confirm(
                    `「${name}」을(를) 회원기관으로 등록하고 이 회원의 소속을 바꾸시겠습니까? 회원에게 알림이 갑니다.`,
                )
            )
                return;
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.registerHospitalFromRequest({
                    adminId: currentUser.id,
                    targetUserId,
                    name,
                });
                if (result.error) throw new Error(result.error.message);
                if (result.data && !result.data.created) {
                    alert(`이미 있는 기관 「${result.data.name}」(으)로 합쳤습니다.`);
                }
                loadAll();
            } catch (err) {
                alert('❌ 기관 등록 처리 중 오류: ' + (err as Error).message);
            }
        }

        async function mergeRequest(targetUserId: string, hospitalId: string) {
            if (!hospitalId) {
                alert('합칠 기존 기관을 먼저 선택하세요.');
                return;
            }
            const name = hospitalName(hospitalId);
            if (!confirm(`이 회원의 소속기관을 기존 기관 「${name}」(으)로 설정하시겠습니까? 회원에게 알림이 갑니다.`))
                return;
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.resolveHospitalRequest({
                    adminId: currentUser.id,
                    targetUserId,
                    hospitalId,
                });
                if (result.error) throw new Error(result.error.message);
                loadAll();
            } catch (err) {
                alert('❌ 합치기 처리 중 오류: ' + (err as Error).message);
            }
        }

        async function declineRequest(targetUserId: string) {
            if (!confirm('이 기관 등록 요청을 거절하시겠습니까? 회원의 소속은 「기타」로 유지되고 알림이 갑니다.'))
                return;
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.resolveHospitalRequest({
                    adminId: currentUser.id,
                    targetUserId,
                });
                if (result.error) throw new Error(result.error.message);
                loadAll();
            } catch (err) {
                alert('❌ 요청 거절 처리 중 오류: ' + (err as Error).message);
            }
        }
    });
</script>

<style>
    .approval-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 0;
    }
    .header {
        margin-bottom: 2rem;
    }
    .page-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .subtitle {
        color: var(--text-muted);
    }
    .section-head {
        margin: 2rem 0 1rem;
    }
    .section-hint {
        margin: 0.4rem 0 0;
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .btn-secondary,
    :global(.btn-secondary) {
        background: transparent;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        padding: 0.4rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .table-wrapper {
        max-height: 600px;
        overflow-y: auto;
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }
    th,
    td {
        padding: 0.75rem 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
    }
    th {
        background: rgba(255, 255, 255, 0.05);
        position: sticky;
        top: 0;
        color: var(--text-muted);
    }
    .actions-cell {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
    }
    :global(.request-actions) {
        flex-direction: column;
        align-items: stretch;
    }
    :global(.request-line) {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
    }
    .btn-approve,
    .btn-reject,
    :global(.btn-approve),
    :global(.btn-reject) {
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-approve,
    :global(.btn-approve) {
        background: #10b981;
        color: white;
    }
    .btn-reject,
    :global(.btn-reject) {
        background: #ef4444;
        color: white;
    }
    :global(.badge-request) {
        display: inline-block;
        margin-left: 0.4rem;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.18);
        color: #f59e0b;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }
    :global(.request-name) {
        padding: 0.35rem 0.5rem;
        font-size: 0.9rem;
        min-width: 14rem;
        flex: 1;
    }
    :global(.request-select) {
        padding: 0.35rem 0.5rem;
        font-size: 0.85rem;
        max-width: 16rem;
    }
</style>
