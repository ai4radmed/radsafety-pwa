---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
---

<DashboardLayout title="의견 관리">
    <style is:global>
        .feedback-container {
            max-width: 1400px;
            margin: 0 auto;
        }
        .page-header {
            margin-bottom: 2rem;
        }
        .page-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Status Tabs */
        .status-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--border-color);
            overflow-x: auto;
        }
        .status-tab {
            padding: 0.65rem 1rem;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-muted);
            transition: all 0.2s;
            white-space: nowrap;
        }
        .status-tab.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }
        .status-tab:hover {
            background: var(--bg-body);
        }

        /* Feedback Table */
        .feedback-table-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }
        .feedback-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        /* Fixed column widths to make ellipsis work reliably (iOS) */
        .feedback-table th:nth-child(2),
        .feedback-table td:nth-child(2) {
            width: 220px;
        }
        .feedback-table th:nth-child(1),
        .feedback-table td:nth-child(1) {
            width: 85px;
            padding-right: 0.25rem; /* keep title close to status */
        }
        .feedback-table thead {
            background: var(--bg-body);
            border-bottom: 2px solid var(--border-color);
        }
        .feedback-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        .feedback-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .feedback-table tbody tr:hover {
            background: var(--bg-hover);
        }
        .feedback-table tbody tr:last-child {
            border-bottom: none;
        }
        .feedback-table td {
            padding: 1rem;
            color: var(--text-main);
            font-size: 0.95rem;
        }

        .feedback-title {
            font-weight: 600;
            font-size: 0.85rem;
            display: block;
            width: 100%;
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            word-break: keep-all;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.85rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Sender cell ellipsis */
        .feedback-sender {
            max-width: 160px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Sender is revealed on row click */
        .feedback-sender-hidden {
            display: none;
        }

        .feedback-sender-trigger {
            color: var(--text-muted);
            font-size: 0.85rem;
            line-height: 1.2;
        }

        .status-text {
            font-weight: 600;
            font-size: 0.85rem;
            display: block;
            width: 100%;
            min-width: 0;
            max-width: 100%;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        /* Status selector (radio segment) in modal */
        .status-radio-group {
            display: flex;
            gap: 0.5rem;
            flex-wrap: nowrap; /* keep on one line */
            align-items: center;
        }

        .status-radio-option {
            flex: 0 0 auto;
            min-width: 0;
        }

        .status-radio-option input {
            display: none;
        }

        .status-radio-label {
            display: block;
            text-align: center;
            padding: 0.35rem 0.6rem;
            border-radius: 999px;
            border: 1px solid var(--border-color);
            background: var(--bg-body);
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .status-radio-option input:checked + .status-radio-label {
            border-color: var(--accent);
            background: var(--accent);
            color: white;
        }

        /* Feedback status badges (4 categories) */
        .badge-reviewing {
            background: #fef3c7;
            color: #92400e;
        }
        .badge-on_hold {
            background: #ede9fe;
            color: #4c1d95;
        }
        .badge-reflected {
            background: #dbeafe;
            color: #1e40af;
        }
        .badge-completed {
            background: #d1fae5;
            color: #065f46;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: var(--text-muted);
        }

        /* Mobile typography (인증관리와 동일 감각) */
        @media (max-width: 768px) {
            .feedback-table th:nth-child(2),
            .feedback-table td:nth-child(2) {
                width: 140px;
            }

            .feedback-table th:nth-child(1),
            .feedback-table td:nth-child(1) {
                width: 60px;
                padding-right: 0.25rem;
            }

            .feedback-title {
                font-size: 0.85rem;
                display: block;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .feedback-sender {
                max-width: 120px;
            }

            .feedback-table th,
            .feedback-table tbody td {
                padding: 0.75rem 0.5rem;
            }

            .status-radio-group {
                gap: 0.25rem;
            }

            .status-radio-label {
                padding: 0.3rem 0.45rem;
                font-size: 0.8rem;
            }
        }

        /* Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-backdrop.active {
            display: flex;
        }
        .modal-content {
            background: var(--bg-card);
            border-radius: 12px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }
        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0.25rem;
        }
        .modal-body {
            padding: 1.5rem;
        }
        .modal-footer {
            padding: 1.5rem;
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }

        .info-row {
            margin-bottom: 1.5rem;
        }
        .info-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .info-value {
            color: var(--text-main);
            font-size: 0.95rem;
        }
        .info-message {
            background: var(--bg-body);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .attachments-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .attachment-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem;
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }
        .attachment-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .attachment-name {
            font-size: 0.9rem;
            color: var(--text-main);
        }
        .attachment-size {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .btn {
            padding: 0.65rem 1.25rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-secondary {
            background: var(--bg-body);
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }
        .btn-secondary:hover {
            background: var(--border-color);
        }
        .btn-primary {
            background: var(--accent);
            color: white;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .btn-danger {
            background: #ef4444;
            color: white;
        }
        .btn-danger:hover {
            background: #dc2626;
        }
        .btn-success {
            background: #10b981;
            color: white;
        }
        .btn-success:hover {
            background: #059669;
        }

        .admin-note-textarea {
            width: 100%;
            min-height: 100px;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-body);
            color: var(--text-main);
            font-family: inherit;
            font-size: 0.95rem;
            resize: vertical;
        }
        .admin-note-textarea:focus {
            outline: none;
            border-color: var(--accent);
        }
    </style>

    <div class="feedback-container">
        <div class="page-header">
            <h1 class="page-title">
                <Icon name="mail" size="32" /> 의견 관리
            </h1>
            <p class="page-subtitle">사용자가 제출한 의견을 확인하고 관리할 수 있습니다.</p>
        </div>

        <!-- Status Tabs -->
        <div class="status-tabs">
            <button class="status-tab active" data-status="all">
                전체 (<span id="feedbackAllCount">0</span>)
            </button>
            <button class="status-tab" data-status="reviewing">
                검토중 (<span id="feedbackReviewingCount">0</span>)
            </button>
            <button class="status-tab" data-status="on_hold">
                보류 (<span id="feedbackOnHoldCount">0</span>)
            </button>
            <button class="status-tab" data-status="completed">
                완료 (<span id="feedbackCompletedCount">0</span>)
            </button>
        </div>

        <!-- Feedback Table -->
        <div class="feedback-table-container">
            <table class="feedback-table">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>제목</th>
                        <th>제출일</th>
                    </tr>
                </thead>
                <tbody id="feedbackTableBody">
                    <tr>
                        <td colspan="3" class="empty-state"> 로딩 중... </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div id="feedbackModal" class="modal-backdrop">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">의견 상세</h2>
                <button class="modal-close" id="closeModal">×</button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Rendered by JS -->
            </div>
            <div class="modal-footer" id="modalFooter">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>

    <script>
        import { supabase } from '../../lib/supabase-browser';
        import { userProfile } from '../../store/user';

        document.addEventListener('astro:page-load', () => {
            // Guard: Admin only (비로그인은 DashboardLayout이 /login으로 리다이렉트)
            const user = userProfile.get() as any;
            if (!user?.id) return; // 비로그인 → Layout auth guard가 처리
            if (user.is_admin !== 'true') {
                alert('관리자 권한이 필요합니다.');
                window.location.href = '/';
            }

            interface Feedback {
                id: string;
                user_name: string;
                user_email: string;
                title: string;
                message: string;
                attachments: Array<{
                    filename: string;
                    storage_path: string;
                    size: number;
                }>;
                // Raw DB values (legacy + new categories)
                status: 'reviewing' | 'on_hold' | 'reflected' | 'completed' | 'pending' | 'processing' | 'resolved';
                admin_note: string | null;
                created_at: string;
                resolved_at: string | null;
            }

            let allFeedback: Feedback[] = [];
            let currentStatus = 'all';
            let selectedFeedback: Feedback | null = null;

            const tableBody = document.getElementById('feedbackTableBody');
            const modal = document.getElementById('feedbackModal');
            const modalBody = document.getElementById('modalBody');
            const modalFooter = document.getElementById('modalFooter');
            const closeModalBtn = document.getElementById('closeModal');

            type NormalizedStatus = 'reviewing' | 'on_hold' | 'completed';

            function normalizeStatus(status: Feedback['status']): NormalizedStatus {
                if (status === 'pending' || status === 'reviewing') return 'reviewing';
                if (status === 'on_hold') return 'on_hold';
                // processing/reflected/resolved/completed are all treated as "completed" in the UI.
                if (
                    status === 'processing' ||
                    status === 'reflected' ||
                    status === 'resolved' ||
                    status === 'completed'
                )
                    return 'completed';
                // Fallback for unexpected values
                return 'reviewing';
            }

            function getStatusLabel(status: NormalizedStatus): string {
                return (
                    {
                        reviewing: '검토중',
                        on_hold: '보류',
                        completed: '완료',
                    }[status] || '검토중'
                );
            }

            function updateCounts() {
                const allEl = document.getElementById('feedbackAllCount');
                const reviewingEl = document.getElementById('feedbackReviewingCount');
                const onHoldEl = document.getElementById('feedbackOnHoldCount');
                const completedEl = document.getElementById('feedbackCompletedCount');

                if (!allEl || !reviewingEl || !onHoldEl || !completedEl) return;

                const all = allFeedback.length;
                const reviewing = allFeedback.filter((f) => normalizeStatus(f.status) === 'reviewing').length;
                const on_hold = allFeedback.filter((f) => normalizeStatus(f.status) === 'on_hold').length;
                const completed = allFeedback.filter((f) => normalizeStatus(f.status) === 'completed').length;

                allEl.textContent = String(all);
                reviewingEl.textContent = String(reviewing);
                onHoldEl.textContent = String(on_hold);
                completedEl.textContent = String(completed);
            }

            // Load feedback from database
            async function loadFeedback() {
                try {
                    const { data, error } = await supabase
                        .from('feedback')
                        .select('*')
                        .order('created_at', { ascending: false });

                    if (error) throw error;

                    allFeedback = data || [];
                    updateCounts();
                    renderTable();
                } catch (error) {
                    console.error('Failed to load feedback:', error);
                    if (tableBody) {
                        tableBody.innerHTML = `
                        <tr>
                            <td colspan="4" class="empty-state">
                                데이터를 불러오는데 실패했습니다.
                            </td>
                        </tr>
                    `;
                    }
                }
            }

            // Render table
            function renderTable() {
                if (!tableBody) return;

                const filtered =
                    currentStatus === 'all'
                        ? allFeedback
                        : allFeedback.filter((f) => normalizeStatus(f.status) === currentStatus);

                if (filtered.length === 0) {
                    tableBody.innerHTML = `
                    <tr>
                        <td colspan="3" class="empty-state">
                            의견이 없습니다.
                        </td>
                    </tr>
                `;
                    return;
                }

                tableBody.innerHTML = filtered
                    .map((feedback) => {
                        const date = new Date(feedback.created_at).toLocaleDateString('ko-KR');
                        const normalized = normalizeStatus(feedback.status);
                        const statusLabel = getStatusLabel(normalized);

                        return `
                    <tr data-id="${feedback.id}">
                        <td>
                            <div class="status-text">${statusLabel}</div>
                        </td>
                        <td>
                            <div class="feedback-title">${feedback.title}</div>
                        </td>
                        <td>${date}</td>
                    </tr>
                `;
                    })
                    .join('');

                // Add click handlers
                tableBody.querySelectorAll('tr[data-id]').forEach((row) => {
                    row.addEventListener('click', () => {
                        const id = (row as HTMLElement).dataset.id;
                        const feedback = allFeedback.find((f) => f.id === id);
                        if (feedback) {
                            openModal(feedback);
                        }
                    });
                });
            }

            // Open modal
            function openModal(feedback: Feedback) {
                selectedFeedback = feedback;
                if (!modal || !modalBody || !modalFooter) return;

                const date = new Date(feedback.created_at).toLocaleString('ko-KR');
                const normalized = normalizeStatus(feedback.status);
                const statusText = getStatusLabel(normalized);

                modalBody.innerHTML = `
                <div class="info-row">
                    <div class="info-label">제목</div>
                    <div class="info-value" style="font-weight: 700; font-size: 1.1rem;">${feedback.title}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">보낸사람</div>
                    <div class="info-value">${feedback.user_name} (${feedback.user_email})</div>
                </div>
                <div class="info-row">
                    <div class="info-label">제출일</div>
                    <div class="info-value">${date}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">상태</div>
                    <div class="info-value">
                        <div class="status-radio-group" role="radiogroup" aria-label="상태 선택">
                            <label class="status-radio-option">
                                <input
                                    type="radio"
                                    name="feedbackStatusRadio"
                                    id="feedbackStatusReviewingRadio"
                                    value="reviewing"
                                    ${normalized === 'reviewing' ? 'checked' : ''}
                                />
                                <span class="status-radio-label">검토중</span>
                            </label>
                            <label class="status-radio-option">
                                <input
                                    type="radio"
                                    name="feedbackStatusRadio"
                                    id="feedbackStatusOnHoldRadio"
                                    value="on_hold"
                                    ${normalized === 'on_hold' ? 'checked' : ''}
                                />
                                <span class="status-radio-label">보류</span>
                            </label>
                            <label class="status-radio-option">
                                <input
                                    type="radio"
                                    name="feedbackStatusRadio"
                                    id="feedbackStatusCompletedRadio"
                                    value="completed"
                                    ${normalized === 'completed' ? 'checked' : ''}
                                />
                                <span class="status-radio-label">완료</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">내용</div>
                    <div class="info-message">${feedback.message}</div>
                </div>
                ${
                    feedback.attachments && feedback.attachments.length > 0
                        ? `
                <div class="info-row">
                    <div class="info-label">첨부파일 (${feedback.attachments.length}개)</div>
                    <div class="attachments-list">
                        ${feedback.attachments
                            .map((att) => {
                                const sizeKB = (att.size / 1024).toFixed(1);
                                return `
                                <div class="attachment-item">
                                    <div class="attachment-info">
                                        <span class="attachment-name">📎 ${att.filename}</span>
                                        <span class="attachment-size">(${sizeKB} KB)</span>
                                    </div>
                                    <button class="btn btn-secondary btn-sm" onclick="downloadAttachment('${att.storage_path}', '${att.filename}')">
                                        다운로드
                                    </button>
                                </div>
                            `;
                            })
                            .join('')}
                    </div>
                </div>
                `
                        : ''
                }
                <div class="info-row">
                    <div class="info-label">관리자 메모</div>
                    <textarea id="adminNote" class="admin-note-textarea" placeholder="메모를 입력하세요...">${feedback.admin_note || ''}</textarea>
                </div>
            `;

                // Footer: always allow status change via radio selector.
                // (Delete is kept only when the current record is completed, like the previous flow.)
                modalFooter.innerHTML = `
                    <button class="btn btn-secondary" id="closeModalBtn">닫기</button>
                    <button class="btn btn-primary" id="saveStatusBtn">상태 저장</button>
                    ${normalized === 'completed' ? `<button class="btn btn-danger" id="deleteBtn">삭제</button>` : ''}
                `;

                // Attach handlers
                document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
                document.getElementById('saveStatusBtn')?.addEventListener('click', () => {
                    const checked = modal?.querySelector(
                        'input[name="feedbackStatusRadio"]:checked',
                    ) as HTMLInputElement | null;
                    if (!checked) {
                        alert('상태를 선택하세요.');
                        return;
                    }
                    updateStatus(checked.value as NormalizedStatus);
                });
                document.getElementById('deleteBtn')?.addEventListener('click', deleteFeedback);

                modal.classList.add('active');
            }

            // Close modal
            function closeModal() {
                modal?.classList.remove('active');
                selectedFeedback = null;
            }

            // Update status
            async function updateStatus(newStatus: NormalizedStatus) {
                if (!selectedFeedback) return;

                const adminNote = (document.getElementById('adminNote') as HTMLTextAreaElement)?.value || null;

                try {
                    const updateData: any = {
                        status: newStatus,
                        admin_note: adminNote,
                    };

                    if (newStatus === 'completed') {
                        updateData.resolved_at = new Date().toISOString();
                        updateData.resolved_by = user.id;
                    } else {
                        // Clear resolved metadata when moving away from completed state.
                        updateData.resolved_at = null;
                        updateData.resolved_by = null;
                    }

                    const { error } = await supabase.from('feedback').update(updateData).eq('id', selectedFeedback.id);

                    if (error) throw error;

                    alert('상태가 업데이트되었습니다.');
                    closeModal();
                    loadFeedback();
                } catch (error) {
                    console.error('Failed to update status:', error);
                    alert('상태 업데이트에 실패했습니다.');
                }
            }

            // Delete feedback
            async function deleteFeedback() {
                if (!selectedFeedback) return;

                if (!confirm('이 의견을 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다.')) {
                    return;
                }

                try {
                    // Delete attachments from storage
                    if (selectedFeedback.attachments && selectedFeedback.attachments.length > 0) {
                        const paths = selectedFeedback.attachments.map((att) => att.storage_path);
                        await supabase.storage.from('feedback-attachments').remove(paths);
                    }

                    // Delete feedback record
                    const { error } = await supabase.from('feedback').delete().eq('id', selectedFeedback.id);

                    if (error) throw error;

                    alert('의견이 삭제되었습니다.');
                    closeModal();
                    loadFeedback();
                } catch (error) {
                    console.error('Failed to delete feedback:', error);
                    alert('삭제에 실패했습니다.');
                }
            }

            // Download attachment
            (window as any).downloadAttachment = async function (storagePath: string, filename: string) {
                try {
                    const { data, error } = await supabase.storage.from('feedback-attachments').download(storagePath);

                    if (error) throw error;

                    const url = URL.createObjectURL(data);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    a.click();
                    URL.revokeObjectURL(url);
                } catch (error) {
                    console.error('Failed to download file:', error);
                    alert('파일 다운로드에 실패했습니다.');
                }
            };

            // Tab switching
            document.querySelectorAll('.status-tab').forEach((tab) => {
                tab.addEventListener('click', (e) => {
                    const target = e.target as HTMLElement;
                    const status = target.dataset.status || 'all';

                    document.querySelectorAll('.status-tab').forEach((t) => t.classList.remove('active'));
                    target.classList.add('active');

                    currentStatus = status;
                    renderTable();
                });
            });

            // Close modal on backdrop click
            modal?.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeModal();
                }
            });

            closeModalBtn?.addEventListener('click', closeModal);

            // Initial load
            loadFeedback();
        }); // End of astro:page-load
    </script>
</DashboardLayout>
