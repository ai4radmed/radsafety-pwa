---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
---

<DashboardLayout title="의견 관리">
    <style>
        .feedback-container {
            max-width: 1400px;
            margin: 0 auto;
        }
        .page-header {
            margin-bottom: 2rem;
        }
        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Status Tabs */
        .status-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--border-color);
            overflow-x: auto;
        }
        .status-tab {
            padding: 0.65rem 1rem;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-muted);
            transition: all 0.2s;
            white-space: nowrap;
        }
        .status-tab.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }
        .status-tab:hover {
            background: var(--bg-body);
        }

        /* Feedback Table */
        .feedback-table-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }
        .feedback-table {
            width: 100%;
            border-collapse: collapse;
        }
        .feedback-table thead {
            background: var(--bg-body);
            border-bottom: 2px solid var(--border-color);
        }
        .feedback-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        .feedback-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .feedback-table tbody tr:hover {
            background: var(--bg-hover);
        }
        .feedback-table tbody tr:last-child {
            border-bottom: none;
        }
        .feedback-table td {
            padding: 1rem;
            color: var(--text-main);
            font-size: 0.95rem;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.85rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .badge-pending {
            background: #fef3c7;
            color: #92400e;
        }
        .badge-processing {
            background: #dbeafe;
            color: #1e40af;
        }
        .badge-resolved {
            background: #d1fae5;
            color: #065f46;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: var(--text-muted);
        }

        /* Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-backdrop.active {
            display: flex;
        }
        .modal-content {
            background: var(--bg-card);
            border-radius: 12px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }
        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0.25rem;
        }
        .modal-body {
            padding: 1.5rem;
        }
        .modal-footer {
            padding: 1.5rem;
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }

        .info-row {
            margin-bottom: 1.5rem;
        }
        .info-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .info-value {
            color: var(--text-main);
            font-size: 0.95rem;
        }
        .info-message {
            background: var(--bg-body);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .attachments-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .attachment-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem;
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }
        .attachment-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .attachment-name {
            font-size: 0.9rem;
            color: var(--text-main);
        }
        .attachment-size {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .btn {
            padding: 0.65rem 1.25rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-secondary {
            background: var(--bg-body);
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }
        .btn-secondary:hover {
            background: var(--border-color);
        }
        .btn-primary {
            background: var(--accent);
            color: white;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .btn-danger {
            background: #ef4444;
            color: white;
        }
        .btn-danger:hover {
            background: #dc2626;
        }
        .btn-success {
            background: #10b981;
            color: white;
        }
        .btn-success:hover {
            background: #059669;
        }

        .admin-note-textarea {
            width: 100%;
            min-height: 100px;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-body);
            color: var(--text-main);
            font-family: inherit;
            font-size: 0.95rem;
            resize: vertical;
        }
        .admin-note-textarea:focus {
            outline: none;
            border-color: var(--accent);
        }
    </style>

    <div class="feedback-container">
        <div class="page-header">
            <h1 class="page-title">
                <Icon name="mail" size="32" /> 의견 관리
            </h1>
            <p class="page-subtitle">사용자가 제출한 의견을 확인하고 관리할 수 있습니다.</p>
        </div>

        <!-- Status Tabs -->
        <div class="status-tabs">
            <button class="status-tab active" data-status="all"> 전체 </button>
            <button class="status-tab" data-status="pending"> 대기중 </button>
            <button class="status-tab" data-status="processing"> 처리중 </button>
            <button class="status-tab" data-status="resolved"> 완료 </button>
        </div>

        <!-- Feedback Table -->
        <div class="feedback-table-container">
            <table class="feedback-table">
                <thead>
                    <tr>
                        <th>제목</th>
                        <th>보낸사람</th>
                        <th>상태</th>
                        <th>첨부파일</th>
                        <th>제출일</th>
                    </tr>
                </thead>
                <tbody id="feedbackTableBody">
                    <tr>
                        <td colspan="5" class="empty-state"> 로딩 중... </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div id="feedbackModal" class="modal-backdrop">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">의견 상세</h2>
                <button class="modal-close" id="closeModal">×</button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Rendered by JS -->
            </div>
            <div class="modal-footer" id="modalFooter">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>

    <script>
        import { supabaseAdmin } from '../../lib/supabase';
        import { userProfile } from '../../store/user';

        // Guard: Admin only
        const user = userProfile.get();
        if (user.is_admin !== 'true') {
            alert('관리자 권한이 필요합니다.');
            window.location.href = '/';
        }

        interface Feedback {
            id: string;
            user_name: string;
            user_email: string;
            title: string;
            message: string;
            attachments: Array<{
                filename: string;
                storage_path: string;
                size: number;
            }>;
            status: 'pending' | 'processing' | 'resolved';
            admin_note: string | null;
            created_at: string;
            resolved_at: string | null;
        }

        let allFeedback: Feedback[] = [];
        let currentStatus = 'all';
        let selectedFeedback: Feedback | null = null;

        const tableBody = document.getElementById('feedbackTableBody');
        const modal = document.getElementById('feedbackModal');
        const modalBody = document.getElementById('modalBody');
        const modalFooter = document.getElementById('modalFooter');
        const closeModalBtn = document.getElementById('closeModal');

        // Load feedback from database
        async function loadFeedback() {
            try {
                const { data, error } = await supabaseAdmin
                    .from('feedback')
                    .select('*')
                    .order('created_at', { ascending: false });

                if (error) throw error;

                allFeedback = data || [];
                renderTable();
            } catch (error) {
                console.error('Failed to load feedback:', error);
                if (tableBody) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="empty-state">
                                데이터를 불러오는데 실패했습니다.
                            </td>
                        </tr>
                    `;
                }
            }
        }

        // Render table
        function renderTable() {
            if (!tableBody) return;

            const filtered =
                currentStatus === 'all' ? allFeedback : allFeedback.filter((f) => f.status === currentStatus);

            if (filtered.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="empty-state">
                            의견이 없습니다.
                        </td>
                    </tr>
                `;
                return;
            }

            tableBody.innerHTML = filtered
                .map((feedback) => {
                    const date = new Date(feedback.created_at).toLocaleDateString('ko-KR');
                    const statusClass = `badge-${feedback.status}`;
                    const statusText = {
                        pending: '대기중',
                        processing: '처리중',
                        resolved: '완료',
                    }[feedback.status];

                    return `
                    <tr data-id="${feedback.id}">
                        <td>
                            <div style="font-weight: 600;">${feedback.title}</div>
                        </td>
                        <td>
                            <div>${feedback.user_name}</div>
                            <div style="font-size: 0.85rem; color: var(--text-muted);">${feedback.user_email}</div>
                        </td>
                        <td>
                            <span class="status-badge ${statusClass}">${statusText}</span>
                        </td>
                        <td>
                            ${feedback.attachments?.length || 0}개
                        </td>
                        <td>${date}</td>
                    </tr>
                `;
                })
                .join('');

            // Add click handlers
            tableBody.querySelectorAll('tr[data-id]').forEach((row) => {
                row.addEventListener('click', () => {
                    const id = row.dataset.id;
                    const feedback = allFeedback.find((f) => f.id === id);
                    if (feedback) {
                        openModal(feedback);
                    }
                });
            });
        }

        // Open modal
        function openModal(feedback: Feedback) {
            selectedFeedback = feedback;
            if (!modal || !modalBody || !modalFooter) return;

            const date = new Date(feedback.created_at).toLocaleString('ko-KR');
            const resolvedDate = feedback.resolved_at ? new Date(feedback.resolved_at).toLocaleString('ko-KR') : '-';

            const statusText = {
                pending: '대기중',
                processing: '처리중',
                resolved: '완료',
            }[feedback.status];

            modalBody.innerHTML = `
                <div class="info-row">
                    <div class="info-label">제목</div>
                    <div class="info-value" style="font-weight: 700; font-size: 1.1rem;">${feedback.title}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">보낸사람</div>
                    <div class="info-value">${feedback.user_name} (${feedback.user_email})</div>
                </div>
                <div class="info-row">
                    <div class="info-label">제출일</div>
                    <div class="info-value">${date}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">상태</div>
                    <div class="info-value">
                        <span class="status-badge badge-${feedback.status}">${statusText}</span>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">내용</div>
                    <div class="info-message">${feedback.message}</div>
                </div>
                ${
                    feedback.attachments && feedback.attachments.length > 0
                        ? `
                <div class="info-row">
                    <div class="info-label">첨부파일 (${feedback.attachments.length}개)</div>
                    <div class="attachments-list">
                        ${feedback.attachments
                            .map((att) => {
                                const sizeKB = (att.size / 1024).toFixed(1);
                                return `
                                <div class="attachment-item">
                                    <div class="attachment-info">
                                        <span class="attachment-name">📎 ${att.filename}</span>
                                        <span class="attachment-size">(${sizeKB} KB)</span>
                                    </div>
                                    <button class="btn btn-secondary btn-sm" onclick="downloadAttachment('${att.storage_path}', '${att.filename}')">
                                        다운로드
                                    </button>
                                </div>
                            `;
                            })
                            .join('')}
                    </div>
                </div>
                `
                        : ''
                }
                <div class="info-row">
                    <div class="info-label">관리자 메모</div>
                    <textarea id="adminNote" class="admin-note-textarea" placeholder="메모를 입력하세요...">${feedback.admin_note || ''}</textarea>
                </div>
            `;

            // Render footer based on status
            if (feedback.status === 'pending') {
                modalFooter.innerHTML = `
                    <button class="btn btn-secondary" id="closeModalBtn">닫기</button>
                    <button class="btn btn-primary" id="startProcessingBtn">처리 시작</button>
                `;
            } else if (feedback.status === 'processing') {
                modalFooter.innerHTML = `
                    <button class="btn btn-secondary" id="closeModalBtn">닫기</button>
                    <button class="btn btn-success" id="resolveBtn">완료 처리</button>
                `;
            } else {
                modalFooter.innerHTML = `
                    <button class="btn btn-secondary" id="closeModalBtn">닫기</button>
                    <button class="btn btn-danger" id="deleteBtn">삭제</button>
                `;
            }

            // Attach handlers
            document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
            document.getElementById('startProcessingBtn')?.addEventListener('click', () => updateStatus('processing'));
            document.getElementById('resolveBtn')?.addEventListener('click', () => updateStatus('resolved'));
            document.getElementById('deleteBtn')?.addEventListener('click', deleteFeedback);

            modal.classList.add('active');
        }

        // Close modal
        function closeModal() {
            modal?.classList.remove('active');
            selectedFeedback = null;
        }

        // Update status
        async function updateStatus(newStatus: 'processing' | 'resolved') {
            if (!selectedFeedback) return;

            const adminNote = (document.getElementById('adminNote') as HTMLTextAreaElement)?.value || null;

            try {
                const updateData: any = {
                    status: newStatus,
                    admin_note: adminNote,
                };

                if (newStatus === 'resolved') {
                    updateData.resolved_at = new Date().toISOString();
                    updateData.resolved_by = user.id;
                }

                const { error } = await supabaseAdmin.from('feedback').update(updateData).eq('id', selectedFeedback.id);

                if (error) throw error;

                alert('상태가 업데이트되었습니다.');
                closeModal();
                loadFeedback();
            } catch (error) {
                console.error('Failed to update status:', error);
                alert('상태 업데이트에 실패했습니다.');
            }
        }

        // Delete feedback
        async function deleteFeedback() {
            if (!selectedFeedback) return;

            if (!confirm('이 의견을 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다.')) {
                return;
            }

            try {
                // Delete attachments from storage
                if (selectedFeedback.attachments && selectedFeedback.attachments.length > 0) {
                    const paths = selectedFeedback.attachments.map((att) => att.storage_path);
                    await supabaseAdmin.storage.from('feedback-attachments').remove(paths);
                }

                // Delete feedback record
                const { error } = await supabaseAdmin.from('feedback').delete().eq('id', selectedFeedback.id);

                if (error) throw error;

                alert('의견이 삭제되었습니다.');
                closeModal();
                loadFeedback();
            } catch (error) {
                console.error('Failed to delete feedback:', error);
                alert('삭제에 실패했습니다.');
            }
        }

        // Download attachment
        (window as any).downloadAttachment = async function (storagePath: string, filename: string) {
            try {
                const { data, error } = await supabaseAdmin.storage.from('feedback-attachments').download(storagePath);

                if (error) throw error;

                const url = URL.createObjectURL(data);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                a.click();
                URL.revokeObjectURL(url);
            } catch (error) {
                console.error('Failed to download file:', error);
                alert('파일 다운로드에 실패했습니다.');
            }
        };

        // Tab switching
        document.querySelectorAll('.status-tab').forEach((tab) => {
            tab.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                const status = target.dataset.status || 'all';

                document.querySelectorAll('.status-tab').forEach((t) => t.classList.remove('active'));
                target.classList.add('active');

                currentStatus = status;
                renderTable();
            });
        });

        // Close modal on backdrop click
        modal?.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        closeModalBtn?.addEventListener('click', closeModal);

        // Initial load
        loadFeedback();
    </script>
</DashboardLayout>
