---
/**
 * 오프라인 fallback 페이지
 *
 * Service Worker가 네트워크 요청 실패 시 이 페이지를 표시합니다.
 * 캐시된 페이지(수검준비, 지적권고사례)로의 링크를 제공합니다.
 *
 * 이 페이지 자체는 precache 대상이므로 오프라인에서도 항상 표시됩니다.
 */
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
    <head>
        <BaseHead title={`오프라인 — ${SITE_TITLE}`} description="인터넷 연결이 필요합니다." />
    </head>
    <body>
        <div class="offline-container">
            <div class="offline-card">
                <div class="icon-wrap">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                        <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
                        <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
                        <path d="M10.71 5.05A16 16 0 0 1 22.56 9"></path>
                        <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
                        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                        <circle cx="12" cy="20" r="1" fill="currentColor"></circle>
                    </svg>
                </div>

                <h1>인터넷 연결 없음</h1>
                <p class="desc">
                    현재 오프라인 상태입니다.<br />
                    인터넷에 연결되면 자동으로 복구됩니다.
                </p>

                <div class="available-section">
                    <p class="available-title">오프라인에서 볼 수 있는 페이지</p>
                    <div class="available-links">
                        <a href="/inspection-prep" class="available-link">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <polyline points="9 11 12 14 22 4"></polyline>
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                            </svg>
                            정기검사 수검준비
                        </a>
                        <a href="/findings-recommendations" class="available-link">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            지적권고사례
                        </a>
                    </div>
                </div>

                <button class="retry-btn" id="retryBtn">다시 시도</button>
            </div>
        </div>

        <script>
            // 온라인 복귀 시 이전 페이지로 자동 이동
            window.addEventListener('online', () => {
                window.location.reload();
            });

            // 다시 시도 버튼
            document.getElementById('retryBtn')?.addEventListener('click', () => {
                window.location.reload();
            });
        </script>

        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100dvh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #0f0f0f;
                font-family:
                    'Pretendard',
                    -apple-system,
                    BlinkMacSystemFont,
                    sans-serif;
                padding: 1rem;
            }

            .offline-container {
                width: 100%;
                max-width: 420px;
            }

            .offline-card {
                background: #1a1a1a;
                border: 1px solid #2e2e2e;
                border-radius: 16px;
                padding: 2.5rem 2rem;
                text-align: center;
                color: #e0e0e0;
            }

            .icon-wrap {
                color: #666;
                margin-bottom: 1.5rem;
            }

            h1 {
                font-size: 1.375rem;
                font-weight: 700;
                margin: 0 0 0.75rem;
                color: #f0f0f0;
            }

            .desc {
                font-size: 0.9rem;
                color: #999;
                line-height: 1.6;
                margin: 0 0 2rem;
            }

            .available-section {
                background: #111;
                border: 1px solid #2a2a2a;
                border-radius: 10px;
                padding: 1.25rem;
                margin-bottom: 1.5rem;
                text-align: left;
            }

            .available-title {
                font-size: 0.75rem;
                color: #666;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                margin: 0 0 0.75rem;
            }

            .available-links {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }

            .available-link {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.625rem 0.75rem;
                background: #1a1a1a;
                border: 1px solid #333;
                border-radius: 8px;
                color: #60a5fa;
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                transition: background 0.15s;
            }

            .available-link:hover {
                background: #222;
            }

            .retry-btn {
                width: 100%;
                padding: 0.75rem;
                background: #2563eb;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.15s;
            }

            .retry-btn:hover {
                background: #1d4ed8;
            }
        </style>
    </body>
</html>
