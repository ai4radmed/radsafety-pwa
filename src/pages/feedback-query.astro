---
export const prerender = false;

import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';
---

<DashboardLayout title="의견 조회">
    <style is:global>
        .feedback-container {
            max-width: 700px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .status-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .status-tab {
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-muted);
            padding: 0.65rem 1rem;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .status-tab.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .feedback-table-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }

        .feedback-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .feedback-table th:nth-child(1),
        .feedback-table td:nth-child(1) {
            width: 85px;
        }

        .feedback-table th:nth-child(2),
        .feedback-table td:nth-child(2) {
            width: 220px;
        }

        .feedback-table thead {
            background: var(--bg-body);
            border-bottom: 2px solid var(--border-color);
        }

        .feedback-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .feedback-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .feedback-table tbody tr:hover {
            background: var(--bg-hover);
        }

        .feedback-table tbody tr:last-child {
            border-bottom: none;
        }

        .feedback-table td {
            padding: 1rem;
            color: var(--text-main);
            font-size: 0.95rem;
        }

        .feedback-title {
            font-weight: 600;
            font-size: 0.85rem;
            display: block;
            width: 100%;
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            word-break: keep-all;
        }

        .status-text {
            font-weight: 600;
            font-size: 0.85rem;
            display: block;
            width: 100%;
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            .feedback-table th:nth-child(1),
            .feedback-table td:nth-child(1) {
                width: 60px;
            }

            .feedback-table th:nth-child(2),
            .feedback-table td:nth-child(2) {
                width: 140px;
            }

            .feedback-table th,
            .feedback-table tbody td {
                padding: 0.75rem 0.5rem;
            }

            .feedback-title {
                font-size: 0.85rem;
            }
        }

        /* Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .modal-backdrop.active {
            display: flex;
        }

        .modal-content {
            background: var(--bg-card);
            border-radius: 12px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0.25rem;
        }

        .modal-body {
            padding: 1.5rem;
        }

        .info-row {
            margin-bottom: 1.25rem;
        }

        .info-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .info-value {
            color: var(--text-main);
            font-size: 0.95rem;
        }

        .info-message {
            background: var(--bg-body);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .attachments-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .attachment-item {
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-body);
        }

        .attachment-name {
            font-weight: 600;
        }
    </style>

    <div class="feedback-container">
        <div class="page-header">
            <h1 class="page-title">
                <Icon name="mail" size="32" /> 의견 조회
            </h1>
            <p class="page-subtitle">관리자가 검토하고 관리자 의견을 남긴 접수만 확인할 수 있습니다.</p>
        </div>

        <!-- Status Tabs -->
        <div class="status-tabs">
            <button class="status-tab active" data-status="all">
                전체 (<span id="feedbackQueryAllCount">0</span>)
            </button>
            <button class="status-tab" data-status="reviewing">
                검토중 (<span id="feedbackQueryReviewingCount">0</span>)
            </button>
            <button class="status-tab" data-status="on_hold">
                보류 (<span id="feedbackQueryOnHoldCount">0</span>)
            </button>
            <button class="status-tab" data-status="completed">
                완료 (<span id="feedbackQueryCompletedCount">0</span>)
            </button>
        </div>

        <!-- Feedback Table -->
        <div class="feedback-table-container">
            <table class="feedback-table">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>제목</th>
                        <th>제출일</th>
                    </tr>
                </thead>
                <tbody id="feedbackQueryTableBody">
                    <tr>
                        <td colspan="3" class="empty-state"> 로딩 중... </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div id="feedbackQueryModal" class="modal-backdrop">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">의견 상세</h2>
                <button class="modal-close" id="closeFeedbackQueryModal">×</button>
            </div>
            <div class="modal-body" id="feedbackQueryModalBody"><!-- Rendered by JS --></div>
        </div>
    </div>

    <script>
        import { supabase } from '../lib/supabase-browser';
        import { userProfile } from '../store/user';

        document.addEventListener('astro:page-load', () => {
            const user = userProfile.get() as any;
            if (!user?.id) return;

            interface Feedback {
                id: string;
                user_name: string;
                user_email: string;
                title: string;
                message: string;
                attachments: Array<{
                    filename: string;
                    storage_path: string;
                    size: number;
                }>;
                status: 'reviewing' | 'on_hold' | 'reflected' | 'completed' | 'pending' | 'processing' | 'resolved';
                admin_note: string | null;
                created_at: string;
                resolved_at: string | null;
            }

            type NormalizedStatus = 'reviewing' | 'on_hold' | 'completed';

            const tableBody = document.getElementById('feedbackQueryTableBody');
            const modal = document.getElementById('feedbackQueryModal');
            const modalBody = document.getElementById('feedbackQueryModalBody');
            const closeModalBtn = document.getElementById('closeFeedbackQueryModal');

            let allFeedback: Feedback[] = [];
            let currentStatus = 'all';
            let selectedFeedback: Feedback | null = null;

            function normalizeStatus(status: Feedback['status']): NormalizedStatus {
                if (status === 'pending' || status === 'reviewing') return 'reviewing';
                if (status === 'on_hold') return 'on_hold';
                if (
                    status === 'processing' ||
                    status === 'reflected' ||
                    status === 'resolved' ||
                    status === 'completed'
                )
                    return 'completed';
                return 'reviewing';
            }

            function getStatusLabel(status: NormalizedStatus): string {
                return (
                    {
                        reviewing: '검토중',
                        on_hold: '보류',
                        completed: '완료',
                    }[status] || '검토중'
                );
            }

            function updateCounts() {
                const allEl = document.getElementById('feedbackQueryAllCount');
                const reviewingEl = document.getElementById('feedbackQueryReviewingCount');
                const onHoldEl = document.getElementById('feedbackQueryOnHoldCount');
                const completedEl = document.getElementById('feedbackQueryCompletedCount');
                if (!allEl || !reviewingEl || !onHoldEl || !completedEl) return;

                const all = allFeedback.length;
                const reviewing = allFeedback.filter((f) => normalizeStatus(f.status) === 'reviewing').length;
                const on_hold = allFeedback.filter((f) => normalizeStatus(f.status) === 'on_hold').length;
                const completed = allFeedback.filter((f) => normalizeStatus(f.status) === 'completed').length;

                allEl.textContent = String(all);
                reviewingEl.textContent = String(reviewing);
                onHoldEl.textContent = String(on_hold);
                completedEl.textContent = String(completed);
            }

            async function loadFeedback() {
                if (!tableBody) return;

                try {
                    const { data, error } = await supabase
                        .from('feedback')
                        .select('*')
                        .not('admin_note', 'is', null)
                        .neq('admin_note', '')
                        .order('created_at', { ascending: false });

                    if (error) throw error;
                    allFeedback = data || [];
                    updateCounts();
                    renderTable();
                } catch (error) {
                    console.error('Failed to load feedback:', error);
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="3" class="empty-state"> 데이터를 불러오는데 실패했습니다. </td>
                        </tr>
                    `;
                }
            }

            function renderTable() {
                if (!tableBody) return;

                const filtered =
                    currentStatus === 'all'
                        ? allFeedback
                        : allFeedback.filter((f) => normalizeStatus(f.status) === currentStatus);

                if (filtered.length === 0) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="3" class="empty-state"> 의견이 없습니다. </td>
                        </tr>
                    `;
                    return;
                }

                tableBody.innerHTML = filtered
                    .map((feedback) => {
                        const date = new Date(feedback.created_at).toLocaleDateString('ko-KR');
                        const normalized = normalizeStatus(feedback.status);
                        const statusLabel = getStatusLabel(normalized);
                        return `
                            <tr data-id="${feedback.id}">
                                <td><div class="status-text">${statusLabel}</div></td>
                                <td><div class="feedback-title">${feedback.title}</div></td>
                                <td>${date}</td>
                            </tr>
                        `;
                    })
                    .join('');

                tableBody.querySelectorAll('tr[data-id]').forEach((row) => {
                    row.addEventListener('click', () => {
                        const id = (row as HTMLElement).dataset.id;
                        const feedback = allFeedback.find((f) => f.id === id);
                        if (feedback) openModal(feedback);
                    });
                });
            }

            function openModal(feedback: Feedback) {
                selectedFeedback = feedback;
                if (!modal || !modalBody) return;

                const date = new Date(feedback.created_at).toLocaleString('ko-KR');
                const normalized = normalizeStatus(feedback.status);
                const statusText = getStatusLabel(normalized);

                modalBody.innerHTML = `
                    <div class="info-row">
                        <div class="info-label">제목</div>
                        <div class="info-value" style="font-weight: 700; font-size: 1.1rem;">${feedback.title}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">보낸사람</div>
                        <div class="info-value">${feedback.user_name} (${feedback.user_email})</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">제출일</div>
                        <div class="info-value">${date}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">상태</div>
                        <div class="info-value"><span class="status-text" style="display:inline-block;">${statusText}</span></div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">내용</div>
                        <div class="info-message">${feedback.message}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">관리자 메모</div>
                        <div class="info-value">${feedback.admin_note || '-'}</div>
                    </div>
                    ${
                        feedback.attachments && feedback.attachments.length > 0
                            ? `
                    <div class="info-row">
                        <div class="info-label">첨부파일 (${feedback.attachments.length}개)</div>
                        <div class="attachments-list">
                            ${feedback.attachments
                                .map((att) => {
                                    const sizeKB = (att.size / 1024).toFixed(1);
                                    return `<div class="attachment-item"><span class="attachment-name">📎 ${att.filename}</span> <span style="color: var(--text-muted); font-size: 0.85rem;">(${sizeKB} KB)</span></div>`;
                                })
                                .join('')}
                        </div>
                    </div>
                    `
                            : ''
                    }
                `;

                modal.classList.add('active');
            }

            function closeModal() {
                if (!modal) return;
                modal.classList.remove('active');
                selectedFeedback = null;
            }

            closeModalBtn?.addEventListener('click', closeModal);
            modal?.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });

            document.querySelectorAll('.status-tab').forEach((tab) => {
                tab.addEventListener('click', (e) => {
                    const target = e.target as HTMLElement;
                    const status = target.dataset.status || 'all';
                    document.querySelectorAll('.status-tab').forEach((t) => t.classList.remove('active'));
                    target.classList.add('active');
                    currentStatus = status;
                    renderTable();
                });
            });

            loadFeedback();
        });
    </script>
</DashboardLayout>
