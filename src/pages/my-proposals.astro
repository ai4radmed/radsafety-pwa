---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/Icon.astro';

// 내 제안(회원 전용) — 아이디 모드로 제출한 제안의 목록·상태·답변·철회. 익명 제안은 여기 없다(접수증 코드로 조회).
// 명세: .spec/src/pages/my-proposals.md
export const prerender = false;
---

<DashboardLayout title="내 제안">
    <div class="mine">
        <div class="page-title"><Icon name="inbox" size="24" /> 내 제안</div>
        <p class="subtitle">
            <strong>아이디</strong>로 제출한 제도 개선 제안입니다. 익명 제안은 계정과 연결되지 않아 여기 표시되지 않으며
            <a href="/proposal-lookup">제안 조회</a>에서 접수증 코드로 확인합니다. 답변 전에는 철회할 수 있습니다.
        </p>
        <div id="list" class="list"><p class="muted">불러오는 중...</p></div>
        <p><a href="/proposals">＋ 새 제안 작성</a></p>
    </div>

    <style>
        .mine {
            max-width: 760px;
            margin: 0 auto;
        }
        .page-title {
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin: 0.5rem 0 1rem;
        }
        .list {
            display: grid;
            gap: 0.7rem;
        }
        .card {
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--accent);
            border-radius: 8px;
            background: var(--bg-card);
            padding: 0.8rem 1rem;
            font-size: 0.9rem;
        }
        .meta {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-bottom: 0.3rem;
        }
        .status {
            border: 1px solid var(--border-color);
            border-radius: 999px;
            padding: 0.05rem 0.5rem;
        }
        .body,
        .reply {
            white-space: pre-wrap;
            line-height: 1.55;
        }
        .reply {
            border-top: 1px dashed var(--border-color);
            margin-top: 0.5rem;
            padding-top: 0.5rem;
        }
        .actions {
            margin-top: 0.5rem;
        }
        .btn-danger {
            background: none;
            border: 1px solid #ef4444;
            color: #ef4444;
            border-radius: 6px;
            padding: 0.3rem 0.7rem;
            cursor: pointer;
            font-size: 0.8rem;
        }
        .muted {
            color: var(--text-muted);
            font-size: 0.85rem;
        }
    </style>
</DashboardLayout>

<script>
    import { supabase } from '../lib/supabase-browser';
    import { actions } from 'astro:actions';

    const STATUS_LABEL: Record<string, string> = {
        new: '접수됨',
        reviewing: '검토 중',
        answered: '답변 완료',
        closed: '종결',
    };
    function esc(s: string | null | undefined): string {
        return (s ?? '').replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
        );
    }

    document.addEventListener('astro:page-load', () => {
        const listEl = document.getElementById('list');
        if (!listEl) return;
        load();

        async function load() {
            // RLS: author_id = auth.uid() 인 signed 행만 온다.
            const { data, error } = await supabase
                .from('proposals')
                .select('id, category, body, status, admin_reply, created_at, answered_at')
                .eq('mode', 'signed')
                .order('created_at', { ascending: false });
            if (error) {
                listEl!.innerHTML = `<p class="muted">불러오지 못했습니다: ${esc(error.message)}</p>`;
                return;
            }
            const rows = data ?? [];
            if (!rows.length) {
                listEl!.innerHTML = '<p class="muted">아이디로 제출한 제안이 없습니다.</p>';
                return;
            }
            listEl!.innerHTML = rows
                .map(
                    (p) => `<div class="card" data-id="${p.id}">
                    <div class="meta">[${esc(p.category)}] ${esc(String(p.created_at).slice(0, 10))} · <span class="status">${STATUS_LABEL[p.status] ?? esc(p.status)}</span></div>
                    <div class="body">${esc(p.body)}</div>
                    ${p.admin_reply ? `<div class="reply"><strong>관리자 답변</strong>${p.answered_at ? ` <span class="meta">(${esc(String(p.answered_at).slice(0, 10))})</span>` : ''}<br/>${esc(p.admin_reply)}</div>` : ''}
                    ${p.status === 'new' || p.status === 'reviewing' ? '<div class="actions"><button class="btn-danger" data-withdraw>철회</button></div>' : ''}
                </div>`,
                )
                .join('');
            listEl!.querySelectorAll<HTMLButtonElement>('[data-withdraw]').forEach((btn) =>
                btn.addEventListener('click', async () => {
                    if (!confirm('이 제안을 철회할까요? 되돌릴 수 없습니다.')) return;
                    const id = btn.closest<HTMLElement>('.card')!.dataset.id!;
                    btn.disabled = true;
                    const { error } = await actions.withdrawProposal({ id });
                    if (error) {
                        alert(`철회 실패: ${error.message}`);
                        btn.disabled = false;
                        return;
                    }
                    load();
                }),
            );
        }
    });
</script>
