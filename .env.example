# PUBLIC_ADMIN_EMAILS=admin1@example.com,admin2@example.com
PUBLIC_ADMIN_EMAILS=admin@example.com

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Note: RESEND_API_KEY와 SUPABASE_SERVICE_ROLE_KEY는 서버 사이드에서만 사용됩니다 (PUBLIC_ 접두사 없음)
# SUPABASE_SERVICE_ROLE_KEY는 Supabase Dashboard > Settings > API > service_role key에서 확인 가능

# 개발용 테스트 계정 (Preview/로컬 전용 — Production에는 설정 금지)
# PUBLIC_DEV_MODE=true 일 때만 /login 페이지에 [개발자 모드] 버튼이 표시됩니다.
# PUBLIC_DEV_MODE=true
# DEV_TEST_USER_EMAIL=test-user@radsafety.kr
# DEV_TEST_USER_PASSWORD=your-test-user-password
# DEV_TEST_ADMIN_EMAIL=test-admin@radsafety.kr
# DEV_TEST_ADMIN_PASSWORD=your-test-admin-password
